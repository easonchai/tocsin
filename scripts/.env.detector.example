# Minimal env for running the detector agent on its own machine. Copy to scripts/.env there.
# The detector key owns detector.eth and detector.tocsin.eth and writes flags under its own namespace.
# Load it from your secret store (1Claw) into this variable at run time rather than keeping it in the file.
DETECTOR_PRIVATE_KEY=0x

# The log on Sepolia and an RPC for it
LOG_ADDRESS=0xb639d15a0e7ae24e4c32e851fbe0e57585565b14
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com

# Mainnet RPC the detector scans
RPC_1=https://ethereum-rpc.publicnode.com

# Then:
#   node --env-file=scripts/.env scripts/agent/detector.mjs --limit 5                      # flag the sample operators under the detector's key (--source live to scan mainnet)
#   node --env-file=scripts/.env scripts/seed/publish-list.mjs --name detector --key-env DETECTOR_PRIVATE_KEY
