# Tocsin on Sepolia. One key per role. A private key is 0x plus 64 hex characters, nothing after it.

# Owns tocsin.eth on the live ENSv2 set, controls the subregistry and the maintainer resolver, signs the core list.
# Today that is the key your teammate used to register tocsin.eth (0x8E2C...3e31).
TOCSIN_PRIVATE_KEY=

# The key whose 92 seed leaves are already in the log (0x36a2...387E). Listed as core's main writer. Defaults to TOCSIN.
CORE_WRITER_PRIVATE_KEY=

# One key per demo claimant. Each registers <label>.eth if needed, deploys its own resolver, claims <label>.tocsin.eth.
BLOCKAID_PRIVATE_KEY=
SCAMSNIFFER_PRIVATE_KEY=

# The detector agent's writer key, used only by scripts/agent/detector.mjs. detector.tocsin.eth resolves to it (0xe3a9...A999).
# setup-all.mjs does not read it.
DETECTOR_PRIVATE_KEY=

# The ThreatFlagLog on Sepolia and an RPC for Sepolia.
LOG_ADDRESS=0xb639d15a0e7ae24e4c32e851fbe0e57585565b14
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com

# RPCs for the chains the seed entries live on, used only to look up evidence tx block numbers.
RPC_1=https://ethereum-rpc.publicnode.com
RPC_56=https://bsc-rpc.publicnode.com
RPC_10=https://optimism-rpc.publicnode.com
RPC_8453=https://mainnet.base.org
RPC_42161=https://arb1.arbitrum.io/rpc
RPC_59144=https://rpc.linea.build

# Pinata API key JWT for scripts/site/pin.mjs (pinFileToIPFS scope is enough)
PINATA_JWT=
