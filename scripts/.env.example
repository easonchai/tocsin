# Copy to scripts/.env (gitignored) and fill in. Run scripts with: node --env-file=scripts/.env scripts/<path>.mjs
# Everything is Sepolia. The log contract address comes from the log-contract deploy ticket.

# The key that owns tocsin.eth on ENSv2 Sepolia, maintains the core list, and (by default) writes the seed leaves.
PRIVATE_KEY=0x

# Optional: a separate writer key for the log. Defaults to PRIVATE_KEY. Must hold Sepolia ETH for gas.
WRITER_PRIVATE_KEY=

# Optional: a second funded key to demo the hub from a third party's seat (4-register-and-claim.mjs). Defaults to PRIVATE_KEY.
CLAIMER_PRIVATE_KEY=

# The detector agent's key. Owns detector.eth and detector.tocsin.eth, writes flags under its own namespace. Keep it in a secret store (1Claw) and load it here at run time.
DETECTOR_PRIVATE_KEY=

# The deployed ThreatFlagLog on Sepolia.
LOG_ADDRESS=0x

# Sepolia RPC (any provider). The ENS scripts and the seed writer use this.
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com

# RPCs for the chains the seed entries live on, used only to look up the evidence tx block number (seenBlock).
RPC_1=https://ethereum-rpc.publicnode.com
RPC_56=https://bsc-rpc.publicnode.com
RPC_10=https://optimism-rpc.publicnode.com
RPC_8453=https://mainnet.base.org
RPC_42161=https://arb1.arbitrum.io/rpc
RPC_59144=https://rpc.linea.build

# Where the signed list document and the leaf snapshot will be served from (content-addressed is best; a repo raw URL is fine for the demo).
LIST_URI=https://raw.githubusercontent.com/easonchai/tocsin/main/docs/plan/demo/seed/core.list.json
SNAPSHOT_URI=https://raw.githubusercontent.com/easonchai/tocsin/main/docs/plan/demo/seed/core.snapshot.json
