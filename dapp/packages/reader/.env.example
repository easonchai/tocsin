# Copy to .env (gitignored). Set one of the two signing options, never both in a shared file.
# Option 1: raw maintainer key, 0x-prefixed 32-byte hex.
MAINTAINER_PRIVATE_KEY=
# Option 2: Foundry keystore name (cast wallet import <name> --interactive); cast prompts for the password.
MAINTAINER_ACCOUNT=

# Used by `publish-list fill` to produce site/lists/default.json from the template.
TOCSIN_MAINTAINER=
TOCSIN_MANUAL_WRITER=
TOCSIN_DETECTOR_WRITER=
# Static host that serves /lists and /mirror, e.g. https://<host>
TOCSIN_SITE_BASE_URL=
# ENS name of the team operating both writers; its namehash becomes each entry's operator.
TOCSIN_OPERATOR_NAME=
