@@ -0,0 +1,109 @@
+// Permits and 7702 authorizations: a tocsin block on the spender stops signing before any signer is asked.
+import { expect } from '@jest/globals'
+
+import { produceMemoryStore } from '../../../test/helpers'
+import { CLEAN, fakeFetch, signedList, SPENDER, world } from '../../../test/helpers/tocsin'
+import { Message } from '../../interfaces/userRequest'
+import { BLOCKED_SIGN_LINE } from '../../libs/tocsin/check'
+import { StorageController } from '../storage/storage'
+import { TocsinController } from '../tocsin/tocsin'
+import { SignMessageController } from './signMessage'
+
+const OWN = '0x00000000000000000000000000000000000000aa'
+
+const until = async (cond: () => boolean) => {
+  for (let i = 0; i < 200 && !cond(); i++) {
+    // eslint-disable-next-line no-await-in-loop
+    await new Promise((r) => {
+      setTimeout(r, 5)
+    })
+  }
+  if (!cond()) throw new Error('condition not met')
+}
+
+async function setup() {
+  world.lists = { 'tocsin.eth': await signedList(`0x${'a1'.repeat(32)}`, 1n) }
+  const tocsin = new TocsinController({
+    storage: new StorageController(produceMemoryStore()),
+    fetch: fakeFetch
+  })
+  await tocsin.updateSettings({ rpcUrl: 'https://rpc.test' })
+  await tocsin.addList('tocsin.eth')
+  await tocsin.confirmAddList()
+  // Records every signer request, so a test can show signing never reached the keystore.
+  const signerRequests: string[] = []
+  const keystore = {
+    getSigner: async (addr: string) => {
+      signerRequests.push(addr)
+      throw new Error('no signer in this test')
+    }
+  }
+  const ctrl = new SignMessageController(
+    keystore as any,
+    {} as any,
+    { networks: [{ chainId: 11155111n }] } as any,
+    { initialLoadPromise: Promise.resolve(), accounts: [], accountStates: {} } as any,
+    {},
+    {} as any,
+    tocsin
+  )
+  return { ctrl, signerRequests }
+}
+
+const permit = (spender: string): Message => ({
+  fromActionId: 1,
+  accountAddr: OWN,
+  chainId: 11155111n,
+  signature: null,
+  content: {
+    kind: 'typedMessage',
+    primaryType: 'Permit',
+    domain: { name: 'Token', version: '1', chainId: 11155111, verifyingContract: CLEAN },
+    types: {},
+    message: { owner: OWN, spender, value: '1', nonce: '0', deadline: '9999999999' }
+  }
+})
+
+describe('SignMessageController with tocsin', () => {
+  test('a block on the permit spender rejects sign() before any signer is asked', async () => {
+    const { ctrl, signerRequests } = await setup()
+    await ctrl.init({ messageToSign: permit(SPENDER) })
+    await until(() => ctrl.tocsin?.verdict === 'block')
+    expect(ctrl.toJSON().tocsin?.assessments[0]?.target.why).toBe('EIP-2612 permit spender')
+
+    ctrl.setSigningKey(OWN, 'internal')
+    await ctrl.sign()
+    expect(signerRequests).toEqual([])
+    expect(ctrl.signedMessage).toBeNull()
+    expect(ctrl.emittedErrors.map((e) => e.message)).toContain(BLOCKED_SIGN_LINE)
+  })
+
+  test('an unflagged spender goes on to the signer; a 7702 authorization checks its delegate', async () => {
+    const { ctrl, signerRequests } = await setup()
+    await ctrl.init({ messageToSign: permit(CLEAN) })
+    await until(() => ctrl.tocsin?.verdict === 'clean')
+    ctrl.setSigningKey(OWN, 'internal')
+    await ctrl.sign()
+    expect(signerRequests).toEqual([OWN])
+
+    await ctrl.init({
+      messageToSign: {
+        fromActionId: 2,
+        accountAddr: OWN,
+        chainId: 11155111n,
+        signature: null,
+        content: {
+          kind: 'authorization-7702',
+          chainId: 11155111n,
+          nonce: 0n,
+          contractAddr: CLEAN,
+          message: '0x'
+        }
+      }
+    })
+    expect(ctrl.tocsinTargets?.targets).toEqual([
+      { address: CLEAN, context: 'delegate', why: 'EIP-7702 delegate' }
+    ])
+    await until(() => ctrl.tocsin?.verdict === 'clean')
+  })
+})
diff --git a/src/controllers/tocsin/tocsin.test.ts b/src/controllers/tocsin/tocsin.test.ts
new file mode 100644
index 000000000..61d864621
--- /dev/null
+++ b/src/controllers/tocsin/tocsin.test.ts
@@ -0,0 +1,178 @@
+// The Snap's bundle-test beats, run against the TocsinController with a fake Sepolia, list host and ENS.
+import { expect } from '@jest/globals'
+
+import { produceMemoryStore } from '../../../test/helpers'
+import {
+  CLEAN,
+  DRAINER,
+  fakeFetch,
+  MANUAL,
+  signedList,
+  SPENDER,
+  SUSPECT,
+  world
+} from '../../../test/helpers/tocsin'
+import { stringify } from '../../libs/richJson/richJson'
+import { causeOf, isChecking, recipientLine } from '../../libs/tocsin/display'
+import { StorageController } from '../storage/storage'
+import { TocsinController } from './tocsin'
+
+const SEPOLIA = 11155111n
+const KEY_A = `0x${'a1'.repeat(32)}` as const
+const KEY_B = `0x${'b2'.repeat(32)}` as const
+const recipient = (address: `0x${string}`) => ({
+  address,
+  context: 'recipient' as const,
+  why: 'recipient'
+})
+
+async function setup() {
+  world.lists = { 'tocsin.eth': await signedList(KEY_A, 1n) }
+  world.requests = []
+  const storage = produceMemoryStore()
+  const ctrl = new TocsinController({ storage: new StorageController(storage), fetch: fakeFetch })
+  await ctrl.initialLoadPromise
+  await ctrl.updateSettings({ rpcUrl: 'https://rpc.test' })
+  await ctrl.addList('tocsin.eth')
+  await ctrl.confirmAddList()
+  return { ctrl, storage }
+}
+
+describe('TocsinController', () => {
+  test('a fresh controller with no list is unavailable, never clean, and says why', async () => {
+    const ctrl = new TocsinController({
+      storage: new StorageController(produceMemoryStore()),
+      fetch: fakeFetch
+    })
+    await ctrl.initialLoadPromise
+    await ctrl.syncNow()
+    expect(ctrl.status?.error).toBe('follow at least one list')
+    const [a] = await ctrl.assess([recipient(DRAINER)], SEPOLIA)
+    expect(a!.verdict).toBe('unavailable')
+    expect(causeOf(ctrl, [a!]).title).toBe('Tocsin has not synced yet')
+  })
+
+  test('add a list: the candidate shows maintainer and writers before anything is pinned', async () => {
+    world.lists = { 'tocsin.eth': await signedList(KEY_A, 1n) }
+    const ctrl = new TocsinController({
+      storage: new StorageController(produceMemoryStore()),
+      fetch: fakeFetch
+    })
+    await ctrl.updateSettings({ rpcUrl: 'https://rpc.test' })
+    await ctrl.addList('tocsin.eth')
+    expect(ctrl.addListCandidate).toMatchObject({
+      name: 'tocsin.eth',
+      maintainer: world.lists['tocsin.eth']!.maintainer,
+      version: 1n,
+      writers: [MANUAL, expect.any(String)]
+    })
+    expect(ctrl.lists).toEqual([])
+    ctrl.cancelAddList()
+    expect(ctrl.addListCandidate).toBeNull()
+    await ctrl.addList('nodot')
+    expect(ctrl.formErrors.listName).toMatch(/not an ENS name/)
+    await ctrl.addList('missing.eth')
+    expect(ctrl.formErrors.listName).toBe('No Tocsin list found at missing.eth.')
+  })
+
+  test('beat 1: the drainer receiver blocks, the clean address has no flags, one weight-1 writer warns', async () => {
+    const { ctrl } = await setup()
+    expect(ctrl.status).toEqual({ at: expect.any(Number) })
+    expect(ctrl.sync?.flags).toBe(3)
+    expect(ctrl.names[MANUAL]).toBe('manual.tocsin.eth')
+    const [block, clean, warn] = await ctrl.assess(
+      [recipient(DRAINER), recipient(CLEAN), recipient(SUSPECT)],
+      SEPOLIA
+    )
+    expect(block).toMatchObject({
+      verdict: 'block',
+      findings: [{ writer: MANUAL, category: 3, list: 'tocsin.eth' }]
+    })
+    expect(clean!.verdict).toBe('clean')
+    expect(warn!.verdict).toBe('warn')
+    expect(ctrl.getAssessment(recipient(DRAINER), SEPOLIA)?.verdict).toBe('block')
+    expect(recipientLine(ctrl, block, isChecking(ctrl))).toMatch(
+      /^Tocsin blocked this recipient: Drainer receiver\./
+    )
+    const [spender] = await ctrl.assess(
+      [{ address: SPENDER, context: 'spender', why: 'ERC-20 approve spender' }],
+      SEPOLIA
+    )
+    expect(spender!.verdict).toBe('block')
+  })
+
+  test('beat 2 and 3: a lying RPC is unverifiable at the dropped sequence; switching back blocks again', async () => {
+    const { ctrl } = await setup()
+    await ctrl.assess([recipient(DRAINER)], SEPOLIA)
+    await ctrl.updateSettings({ rpcUrl: 'https://liar.test' })
+    const a = ctrl.getAssessment(recipient(DRAINER), SEPOLIA)!
+    expect(a.verdict).toBe('unavailable')
+    expect(ctrl.sync?.writers[MANUAL]).toMatchObject({ status: 'unavailable', divergedAt: 1n })
+    expect(causeOf(ctrl, [a]).title).toBe("The RPC's data does not match Ethereum")
+    expect(ctrl.lastGood?.flags).toBe(3)
+    await ctrl.updateSettings({ rpcUrl: 'https://rpc.test' })
+    expect(ctrl.getAssessment(recipient(DRAINER), SEPOLIA)?.verdict).toBe('block')
+  })
+
+  test('a changed maintainer is held as pending and excluded until accepted', async () => {
+    const { ctrl } = await setup()
+    world.lists = { 'tocsin.eth': await signedList(KEY_B, 2n) }
+    await ctrl.syncNow()
+    const [list] = ctrl.lists
+    expect(list).toMatchObject({ name: 'tocsin.eth', status: 'maintainer changed' })
+    expect(list!.pending?.maintainer).toBe(world.lists['tocsin.eth']!.maintainer)
+    expect(list!.pinned?.maintainer).not.toBe(list!.pending?.maintainer)
+    const [a] = await ctrl.assess([recipient(DRAINER)], SEPOLIA)
+    expect(a!.verdict).toBe('unavailable')
+    expect(causeOf(ctrl, [a!]).title).toBe('No list to check against')
+    await ctrl.acceptMaintainerChange('tocsin.eth')
+    expect(ctrl.lists[0]?.status).toBe('accepted')
+    expect(ctrl.lists[0]?.pending).toBeUndefined()
+    expect(ctrl.getAssessment(recipient(DRAINER), SEPOLIA)?.verdict).toBe('block')
+  })
+
+  test('unfollow drops the list from evaluation, follow keeps its pin, remove deletes it', async () => {
+    const { ctrl } = await setup()
+    await ctrl.assess([recipient(DRAINER)], SEPOLIA)
+    await ctrl.setFollowed('tocsin.eth', false)
+    expect(ctrl.getAssessment(recipient(DRAINER), SEPOLIA)?.verdict).toBe('unavailable')
+    await ctrl.setFollowed('tocsin.eth', true)
+    expect(ctrl.lists[0]?.pinned).toBeDefined()
+    expect(ctrl.getAssessment(recipient(DRAINER), SEPOLIA)?.verdict).toBe('block')
+    await ctrl.removeList('tocsin.eth')
+    expect(ctrl.lists).toEqual([])
+  })
+
+  test('an RPC on another chain fails the sync, keeps the last result and says so', async () => {
+    const { ctrl } = await setup()
+    world.chainId = '0x1'
+    await ctrl.syncNow()
+    world.chainId = '0xaa36a7'
+    expect(ctrl.status?.error).toMatch(/is not Sepolia/)
+    expect(ctrl.sync?.flags).toBe(3)
+  })
+
+  test('state survives a restart from storage, and no evaluated address is ever stored', async () => {
+    const { ctrl, storage } = await setup()
+    await ctrl.assess([recipient(DRAINER), recipient(CLEAN)], SEPOLIA)
+    // DRAINER is a flag subject in the log, so it is in the stored leaves; CLEAN appears nowhere but the check.
+    const stored = stringify(await storage.get(undefined))
+    expect(stored.toLowerCase()).not.toContain(CLEAN.slice(2).toLowerCase())
+    const again = new TocsinController({
+      storage: new StorageController(storage),
+      fetch: fakeFetch
+    })
+    await again.initialLoadPromise
+    expect(again.sync?.flags).toBe(3)
+    expect(again.assessments).toEqual({})
+    const [a] = await again.assess([recipient(DRAINER)], SEPOLIA)
+    expect(a!.verdict).toBe('block')
+  })
+
+  test('bad RPC input is a field error and changes nothing', async () => {
+    const { ctrl } = await setup()
+    await ctrl.updateSettings({ rpcUrl: 'http://rpc.example' })
+    expect(ctrl.formErrors.rpcUrl).toBe('Enter an https URL (http only for localhost).')
+    expect(ctrl.settings.rpcUrl).toBe('https://rpc.test/')
+  })
+})
diff --git a/src/controllers/tocsin/tocsin.ts b/src/controllers/tocsin/tocsin.ts
