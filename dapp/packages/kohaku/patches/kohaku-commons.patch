+++ b/src/libs/tocsin/decode.test.ts
@@ -0,0 +1,200 @@
+// Which address tocsin evaluates, and in which context. Ported from the antibody Snap's
+// test/decode.test.ts; jest's global `test` replaces node:test, the assertions are unchanged.
+import assert from 'node:assert/strict'
+import { encodeFunctionData, getAddress, maxUint256, parseAbi, zeroAddress } from 'viem'
+import { signatureTargets, transactionTargets } from './decode'
+import { parseListName, parseRpcUrl } from './settings'
+
+const TOKEN = getAddress('0x1111111111111111111111111111111111111111')
+const BAD = getAddress('0xbad0000000000000000000000000000000000bad')
+const PERMIT2 = getAddress('0x000000000022D473030F116dDEE9F6B43aC78BA3')
+
+const abi = parseAbi([
+  'function transfer(address to, uint256 amount)',
+  'function approve(address spender, uint256 amount)',
+  'function setApprovalForAll(address operator, bool approved)',
+  'function permit(address owner, address spender, uint256 value, uint256 deadline, uint8 v, bytes32 r, bytes32 s)',
+  'function approve(address token, address spender, uint160 amount, uint48 expiration)',
+  'struct PermitDetails { address token; uint160 amount; uint48 expiration; uint48 nonce; }',
+  'struct PermitSingle { PermitDetails details; address spender; uint256 sigDeadline; }',
+  'struct PermitBatch { PermitDetails[] details; address spender; uint256 sigDeadline; }',
+  'function permit(address owner, PermitSingle permitSingle, bytes signature)',
+  'function permit(address owner, PermitBatch permitBatch, bytes signature)',
+  'function balanceOf(address who) view returns (uint256)',
+  'struct ExactInputSingleParams { address tokenIn; address tokenOut; uint24 fee; address recipient; uint256 amountIn; uint256 amountOutMinimum; uint160 sqrtPriceLimitX96; }',
+  'function exactInputSingle(ExactInputSingleParams params) payable returns (uint256 amountOut)'
+])
+const ROUTER = getAddress('0x2222222222222222222222222222222222222222')
+const details = { token: TOKEN, amount: 1n, expiration: 1, nonce: 0 }
+const pick = (ts: ReturnType<typeof transactionTargets>) => ts.map((t) => [t.address, t.context])
+
+test('a plain send evaluates `to` as recipient', () => {
+  assert.deepEqual(pick(transactionTargets({ to: BAD.toLowerCase(), data: '0x' })), [
+    [BAD, 'recipient']
+  ])
+})
+
+test('contract creation has no target', () => {
+  assert.deepEqual(transactionTargets({ to: null, data: '0x6080' }), [])
+})
+
+test('ERC-20 transfer adds the decoded recipient', () => {
+  const data = encodeFunctionData({ abi, functionName: 'transfer', args: [BAD, 5n] })
+  assert.deepEqual(pick(transactionTargets({ to: TOKEN, data })), [
+    [TOKEN, 'recipient'],
+    [BAD, 'recipient']
+  ])
+})
+
+test('ERC-20 approve adds the spender', () => {
+  const data = encodeFunctionData({ abi, functionName: 'approve', args: [BAD, maxUint256] })
+  const ts = transactionTargets({ to: TOKEN, data })
+  assert.deepEqual(pick(ts), [
+    [TOKEN, 'recipient'],
+    [BAD, 'spender']
+  ])
+  assert.equal(ts[1]?.why, 'ERC-20 approve spender')
+})
+
+test('setApprovalForAll adds the operator as spender', () => {
+  const data = encodeFunctionData({ abi, functionName: 'setApprovalForAll', args: [BAD, true] })
+  assert.deepEqual(pick(transactionTargets({ to: TOKEN, data }))[1], [BAD, 'spender'])
+})
+
+test('EIP-2612 permit sent as a transaction adds the spender, not the owner', () => {
+  const data = encodeFunctionData({
+    abi,
+    functionName: 'permit',
+    args: [TOKEN, BAD, 1n, 1n, 27, `0x${'11'.repeat(32)}`, `0x${'22'.repeat(32)}`]
+  })
+  const ts = transactionTargets({ to: TOKEN, data })
+  assert.deepEqual(pick(ts)[1], [BAD, 'spender'])
+  assert.equal(ts[1]?.why, 'EIP-2612 permit spender')
+})
+
+test('Permit2 approve adds the spender, not the token', () => {
+  const data = encodeFunctionData({ abi, functionName: 'approve', args: [TOKEN, BAD, 1n, 1] })
+  const ts = transactionTargets({ to: PERMIT2, data })
+  assert.deepEqual(pick(ts), [
+    [PERMIT2, 'recipient'],
+    [BAD, 'spender']
+  ])
+  assert.equal(ts[1]?.why, 'Permit2 approve spender')
+})
+
+test('Permit2 permit, single and batch, adds the spender', () => {
+  const single = encodeFunctionData({
+    abi,
+    functionName: 'permit',
+    args: [TOKEN, { details, spender: BAD, sigDeadline: 1n }, '0x']
+  })
+  const batch = encodeFunctionData({
+    abi,
+    functionName: 'permit',
+    args: [TOKEN, { details: [details, details], spender: BAD, sigDeadline: 1n }, '0x']
+  })
+  for (const data of [single, batch]) {
+    const ts = transactionTargets({ to: PERMIT2, data })
+    assert.deepEqual(pick(ts)[1], [BAD, 'spender'])
+    assert.equal(ts[1]?.why, 'Permit2 permit spender')
+  }
+})
+
+test('SwapRouter02 exactInputSingle adds the swap recipient alongside the router', () => {
+  const data = encodeFunctionData({
+    abi,
+    functionName: 'exactInputSingle',
+    args: [
+      {
+        tokenIn: TOKEN,
+        tokenOut: zeroAddress,
+        fee: 3000,
+        recipient: BAD,
+        amountIn: 1n,
+        amountOutMinimum: 0n,
+        sqrtPriceLimitX96: 0n
+      }
+    ]
+  })
+  const ts = transactionTargets({ to: ROUTER, data })
+  assert.deepEqual(pick(ts), [
+    [ROUTER, 'recipient'],
+    [BAD, 'recipient']
+  ])
+  assert.equal(ts[1]?.why, 'swap recipient')
+})
+
+test('unknown or malformed calldata adds nothing beyond `to`', () => {
+  const known = encodeFunctionData({ abi, functionName: 'balanceOf', args: [BAD] })
+  assert.deepEqual(pick(transactionTargets({ to: TOKEN, data: known })), [[TOKEN, 'recipient']])
+  assert.deepEqual(pick(transactionTargets({ to: TOKEN, data: '0xa9059cbb1234' })), [
+    [TOKEN, 'recipient']
+  ])
+})
+
+const permit = {
+  types: {
+    EIP712Domain: [{ name: 'chainId', type: 'uint256' }],
+    Permit: [
+      { name: 'owner', type: 'address' },
+      { name: 'spender', type: 'address' }
+    ]
+  },
+  primaryType: 'Permit',
+  domain: { name: 'Token', chainId: 11155111, verifyingContract: TOKEN },
+  message: { owner: TOKEN, spender: BAD.toLowerCase(), value: '1', nonce: '0', deadline: '1' }
+}
+
+test('EIP-2612 typed data yields the spender and the domain chain, as an object or a JSON string', () => {
+  for (const data of [permit, JSON.stringify(permit)]) {
+    const { targets, chainId } = signatureTargets(data)
+    assert.deepEqual(pick(targets), [[BAD, 'spender']])
+    assert.equal(chainId, 11155111n)
+  }
+})
+
+test('Permit2 typed data yields the spender', () => {
+  for (const primaryType of [
+    'PermitSingle',
+    'PermitBatch',
+    'PermitTransferFrom',
+    'PermitWitnessTransferFrom'
+  ]) {
+    const data = {
+      primaryType,
+      domain: { name: 'Permit2', chainId: '0xaa36a7' },
+      message: { details, spender: BAD }
+    }
+    const { targets, chainId } = signatureTargets(data)
+    assert.deepEqual(pick(targets), [[BAD, 'spender']], primaryType)
+    assert.equal(targets[0]?.why, 'Permit2 permit spender')
+    assert.equal(chainId, 11155111n)
+  }
+})
+
+test('other typed data and garbage yield no target', () => {
+  assert.deepEqual(signatureTargets({ ...permit, primaryType: 'Mail' }).targets, [])
+  assert.deepEqual(
+    signatureTargets({ ...permit, message: { spender: 'not an address' } }).targets,
+    []
+  )
+  assert.deepEqual(
+    signatureTargets({ ...permit, message: { spender: zeroAddress } }).targets.length,
+    1
+  )
+  assert.deepEqual(signatureTargets('{not json').targets, [])
+  assert.deepEqual(signatureTargets(null).targets, [])
+})
+
+test('RPC URL: https anywhere, http only for localhost', () => {
+  assert.deepEqual(parseRpcUrl(' https://rpc.example '), { url: 'https://rpc.example/' })
+  assert.deepEqual(parseRpcUrl('http://127.0.0.1:8550'), { url: 'http://127.0.0.1:8550/' })
+  for (const bad of ['http://rpc.example', 'ftp://x', '', 7])
+    assert.ok('error' in parseRpcUrl(bad), String(bad))
+})
+
+test('list name: normalised ENS name with a dot', () => {
+  assert.deepEqual(parseListName(' Seal.Tocsin.eth '), { name: 'seal.tocsin.eth' })
+  for (const bad of ['nodot', '', undefined, 'a b.eth'])
+    assert.ok('error' in parseListName(bad), String(bad))
+})
diff --git a/src/libs/tocsin/decode.ts b/src/libs/tocsin/decode.ts
new file mode 100644
index 000000000..ceae19476
--- /dev/null
+++ b/src/libs/tocsin/decode.ts
@@ -0,0 +1,141 @@
+// Which addresses in a transaction or a typed-data signature the reader evaluates, and as what.
+// Copied from the antibody Snap (dapp/packages/snap/src/decode.ts). Pure: imports only viem.
+import {
+  type Address,
+  type Hex,
+  decodeFunctionData,
+  getAddress,
+  isAddress,
+  isHex,
+  parseAbi
+} from 'viem'
+
+/** Mirrors the reader's `Context` for the two the Snap's hooks can see. */
+/** `delegate` is Kohaku's addition: an EIP-7702 authorization's contract, where MALICIOUS_DELEGATE applies. */
+export type Target = {
+  address: Address
+  context: 'recipient' | 'spender' | 'delegate'
+  why: string
+}
+
+const callsAbi = parseAbi([
+  'function transfer(address to, uint256 amount)',
+  'function approve(address spender, uint256 amount)',
+  'function setApprovalForAll(address operator, bool approved)',
+  // EIP-2612 permit sent as a transaction (anyone may relay it).
+  'function permit(address owner, address spender, uint256 value, uint256 deadline, uint8 v, bytes32 r, bytes32 s)',
+  // Permit2 AllowanceTransfer.
+  'function approve(address token, address spender, uint160 amount, uint48 expiration)',
+  'struct PermitDetails { address token; uint160 amount; uint48 expiration; uint48 nonce; }',
+  'struct PermitSingle { PermitDetails details; address spender; uint256 sigDeadline; }',
+  'struct PermitBatch { PermitDetails[] details; address spender; uint256 sigDeadline; }',
+  'function permit(address owner, PermitSingle permitSingle, bytes signature)',
+  'function permit(address owner, PermitBatch permitBatch, bytes signature)',
+  // Uniswap SwapRouter02.
+  'struct ExactInputSingleParams { address tokenIn; address tokenOut; uint24 fee; address recipient; uint256 amountIn; uint256 amountOutMinimum; uint160 sqrtPriceLimitX96; }',
+  'function exactInputSingle(ExactInputSingleParams params) payable returns (uint256 amountOut)'
+])
+
+const unique = (targets: Target[]): Target[] =>
+  targets.filter(
+    (t, i) => targets.findIndex((u) => u.address === t.address && u.context === t.context) === i
+  )
+
+/** `to` as recipient, plus the spender, recipient, or operator decoded from known calldata. Unknown calldata adds nothing. */
+export function transactionTargets(tx: { to?: string | null; data?: string | null }): Target[] {
+  const out: Target[] = []
+  if (tx.to && isAddress(tx.to, { strict: false }))
+    out.push({ address: getAddress(tx.to), context: 'recipient', why: 'recipient' })
+  if (!tx.data || !isHex(tx.data) || tx.data.length < 10) return out
+  let call
+  try {
+    call = decodeFunctionData({ abi: callsAbi, data: tx.data as Hex })
+  } catch {
+    return out // not one of the calls above
+  }
+  const { functionName, args } = call
+  if (functionName === 'transfer')
+    out.push({
+      address: getAddress(args[0]),
+      context: 'recipient',
+      why: 'ERC-20 transfer recipient'
+    })
+  else if (functionName === 'exactInputSingle')
+    out.push({
+      address: getAddress(args[0].recipient),
+      context: 'recipient',
+      why: 'swap recipient'
+    })
+  else if (functionName === 'setApprovalForAll')
+    out.push({
+      address: getAddress(args[0]),
+      context: 'spender',
+      why: 'setApprovalForAll operator'
+    })
+  else if (functionName === 'approve')
+    out.push(
+      args.length === 2
+        ? { address: getAddress(args[0]), context: 'spender', why: 'ERC-20 approve spender' }
+        : { address: getAddress(args[1]), context: 'spender', why: 'Permit2 approve spender' }
+    )
+  else if (functionName === 'permit')
+    out.push(
+      args.length === 7
+        ? { address: getAddress(args[1]), context: 'spender', why: 'EIP-2612 permit spender' }
+        : {
+            address: getAddress(args[1].spender),
+            context: 'spender',
+            why: 'Permit2 permit spender'
+          }
+    )
+  return unique(out)
+}
+
+/** Permit2 primary types whose message carries `spender` at the top level. */
+const PERMIT2_TYPES = new Set([
+  'PermitSingle',
+  'PermitBatch',
+  'PermitTransferFrom',
+  'PermitBatchTransferFrom',
+  'PermitWitnessTransferFrom',
+  'PermitBatchWitnessTransferFrom'
+])
+
+/**
+ * The spender of an EIP-2612 `Permit` or a Permit2 permit in `eth_signTypedData_v3/v4` data, and the
+ * chain id from its domain. Anything else, including malformed data, yields no target.
+ */
+export function signatureTargets(data: unknown): { targets: Target[]; chainId?: bigint } {
+  let typed: unknown = data
+  if (typeof data === 'string') {
+    try {
+      typed = JSON.parse(data)
+    } catch {
+      return { targets: [] }
+    }
+  }
+  if (typeof typed !== 'object' || typed === null) return { targets: [] }
+  // SAFETY: only read through optional access; each field is checked before use.
+  const t = typed as {
+    primaryType?: unknown
+    domain?: { chainId?: unknown }
+    message?: { spender?: unknown }
+  }
+  const raw = t.domain?.chainId
+  const chainId =
+    typeof raw === 'number' || (typeof raw === 'string' && /^(0x[0-9a-fA-F]+|\d+)$/.test(raw))
+      ? BigInt(raw)
+      : undefined
+  const spender = t.message?.spender
+  const kind =
+    t.primaryType === 'Permit'
+      ? 'EIP-2612 permit spender'
+      : PERMIT2_TYPES.has(String(t.primaryType))
+      ? 'Permit2 permit spender'
+      : undefined
+  const targets: Target[] =
+    kind && typeof spender === 'string' && isAddress(spender, { strict: false })
+      ? [{ address: getAddress(spender), context: 'spender', why: kind }]
+      : []
+  return chainId === undefined ? { targets } : { targets, chainId }
+}
diff --git a/src/libs/tocsin/display.ts b/src/libs/tocsin/display.ts
new file mode 100644
index 000000000..61a573d48
--- /dev/null
+++ b/src/libs/tocsin/display.ts
@@ -0,0 +1,345 @@
+// The words every Tocsin screen uses, without any UI framework. Ported from the antibody Snap's
+// ui.tsx (dapp/packages/snap/src/ui.tsx) so Kohaku screens say exactly what the Snap says.
+// Inputs are the TocsinController's public state (`TocsinView`) and its cached assessments.
+import type { Address, Hex } from 'viem'
+
+import type { Target } from './decode'
+import type { Verdict } from './reader'
+import { type LastGood, LOG_CHAIN_ID, type Settings, type SyncStatus } from './state'
+
+/** A verified list, reduced to what a screen shows. */
+export type ListSummary = { maintainer: Address; version: bigint; writers: Address[] }
+
+export type ListView = {
+  name: string
+  followed: boolean
+  /** acceptList's status at the last sync, e.g. "accepted", "stale", "rejected (bad-signature)". */
+  status?: string
+  pinned?: ListSummary
+  /** Set when the maintainer changed: the list is excluded until `acceptMaintainerChange`. */
+  pending?: ListSummary
+}
+
+/** The reader's WriterSync without its leaves, error as text. */
+export type WriterView = {
+  status: 'synced' | 'unavailable'
+  writer: Address
+  seq: bigint
+  head: Hex
+  /** First writer sequence whose replayed data did not match the proven head (lying RPC). */
+  divergedAt?: bigint
+  error?: string
+}
+
+export type SyncView = {
+  /** `unverified` is always true here: the header comes from an RPC, not a light client. */
+  block: { number: bigint; hash: Hex; unverified?: true }
+  flags: number
+  writers: Record<Address, WriterView>
+}
+
+export type TocsinFinding = {
+  writer: Address
+  /** ERC category number; `category(n)` gives its name, title and description. */
+  category: number
+  /** A transaction hash or the hash of an off-chain evidence bundle. */
+  evidence: Hex
+  seenBlock: bigint
+  weight: number
+  /** The followed list that carries this writer. */
+  list: string
+}
+
+export type TocsinAssessment = {
+  target: Target
+  chainId: bigint
+  /** `unavailable` also when there is no sync or no usable list yet; `causeOf` says which. */
+  verdict: Verdict
+  findings: TocsinFinding[]
+  /** Pinned writers whose leaves are unavailable. */
+  unavailable: Address[]
+}
+
+/** The TocsinController fields these helpers read. */
+export type TocsinView = {
+  settings: Settings
+  lists: ListView[]
+  sync: SyncView | null
+  syncedAt: number | null
+  lastGood: LastGood | null
+  names: Record<Address, string>
+  status: SyncStatus | null
+  isSyncing: boolean
+  /** False until the stored state has loaded. */
+  isReady: boolean
+}
+
+export const PRIVACY_LINE = 'Checked on this device. Nothing was sent to anyone.'
+export const NETWORK_NOTE =
+  'Tocsin reads one RPC here, best effort, not a light client. The RPC you pick can see which flags you download, never which address you check.'
+export const POLICY_LINES = [
+  'Blocks when one weight-255 writer, or two independent writers, on a list you follow flag the address. One writer alone is a warning.',
+  'THEFT_PROCEEDS is a warning on a send screen. Approvals, permits and transfers are always checked.'
+]
+export const ABOUT_LINE =
+  'Tocsin is an open, append-only log of scam infrastructure on Ethereum. Flags come from writers on lists you choose. Nothing is ever removed.'
+export const STANDARD_URL = 'https://tocsin.eth.limo/erc.html'
+export const SOURCE_URL = 'https://github.com/easonchai/antibody'
+
+/** The ERC's category table: name, plain title, and what the subject is. */
+export const CATEGORY: Record<number, { name: string; title: string; desc: string }> = {
+  1: {
+    name: 'POISONING_OPERATOR',
+    title: 'Poisoning operator',
+    desc: "This account sends transfers that plant lookalike addresses in victims' histories."
+  },
+  2: {
+    name: 'POISONING_FUNDER',
+    title: 'Poisoning funder',
+    desc: 'This account funded addresses later used in address poisoning.'
+  },
+  3: {
+    name: 'DRAINER_RECEIVER',
+    title: 'Drainer receiver',
+    desc: 'This address receives funds forwarded by wallet drainers.'
+  },
+  4: {
+    name: 'MALICIOUS_DELEGATE',
+    title: 'Malicious delegate',
+    desc: "This EIP-7702 delegate sweeps the delegating account's assets to a hard-coded address."
+  },
+  5: {
+    name: 'MALICIOUS_TOKEN',
+    title: 'Malicious token',
+    desc: 'This token contract emits misleading transfer events.'
+  },
+  6: {
+    name: 'PAID_LOOKALIKE',
+    title: 'Paid lookalike',
+    desc: 'A victim has already paid this lookalike address.'
+  },
+  7: {
+    name: 'DRAINER_SPENDER',
+    title: 'Drainer spender',
+    desc: 'This contract has used permits and approvals to drain wallets.'
+  },
+  8: {
+    name: 'THEFT_PROCEEDS',
+    title: 'Theft proceeds',
+    desc: 'This account holds the proceeds of a theft a writer verified.'
+  }
+}
+export const category = (c: number) =>
+  CATEGORY[c] ?? {
+    name: `CATEGORY_${c}`,
+    title: `Writer-defined category ${c}`,
+    desc: 'A category the writer defines.'
+  }
+
+export const short = (a: string) => `${a.slice(0, 6)}…${a.slice(-4)}`
+export const num = (n: number | bigint) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ',')
+export const plural = (n: number, word: string) => `${num(n)} ${word}${n === 1 ? '' : 's'}`
+export function ago(at: number, now = Date.now()): string {
+  const m = Math.round((now - at) / 60_000)
+  if (m < 1) return 'just now'
+  if (m < 60) return `${m} min ago`
+  const h = Math.round(m / 60)
+  return h < 48 ? `${h} h ago` : `${Math.round(h / 24)} days ago`
+}
+export const host = (url: string) => {
+  try {
+    return new URL(url).host
+  } catch {
+    return url
+  }
+}
+const unique = <T>(xs: readonly T[]) => [...new Set(xs)]
+
+/** Writers are shown by forward-checked ENS name, else a shortened address. */
+export const writerLabel = (view: TocsinView, w: Address) => view.names[w] ?? short(w)
+
+/** The key `TocsinController.assessments` uses. */
+export const assessmentKey = (target: Pick<Target, 'address' | 'context'>, chainId: bigint) =>
+  `${target.context}:${target.address.toLowerCase()}:${chainId}`
+
+export const RANK: Record<Verdict, number> = { clean: 0, unavailable: 1, warn: 2, block: 3 }
+export const worst = (as: readonly { verdict: Verdict }[]): Verdict =>
+  as.reduce<Verdict>((v, a) => (RANK[a.verdict] > RANK[v] ? a.verdict : v), 'clean')
+
+/** Followed lists the check applies: pinned and with no pending maintainer change. */
+export const usable = (l: ListView) =>
+  l.followed && l.pinned !== undefined && l.pending === undefined
+
+/** No sync result yet and one is running, or the controller has not loaded: say "checking", never block. */
+export const isChecking = (view: TocsinView) => !view.isReady || (!view.sync && view.isSyncing)
+
+export function whyUnavailable(s: WriterView | undefined): string {
+  if (!s) return 'not synced yet'
+  if (s.status === 'synced') return `synced to sequence ${s.seq}`
+  if (s.divergedAt !== undefined) return `chain mismatch at sequence ${s.divergedAt}`
+  return `source failed${s.error ? `: ${s.error}` : ''}`
+}
+
+export const proven = (view: TocsinView): string => {
+  const s = view.sync
+  if (!s) return 'nothing proven yet'
+  const ws = Object.values(s.writers)
+  return ws.length === 1
+    ? `head ${short(ws[0]!.head)} · block ${num(s.block.number)}`
+    : `${plural(ws.length, 'writer head')} · block ${num(s.block.number)}`
+}
+
+export const sourceLine = (view: TocsinView) =>
+  `header and proof from ${host(view.settings.rpcUrl)} · best effort, not a light client`
+
+/** "41,207 flags · 2 writers · 4 min ago", or "never". */
+export const syncedLine = (view: TocsinView) =>
+  view.sync && view.syncedAt
+    ? `${num(view.sync.flags)} flags · ${plural(
+        Object.keys(view.sync.writers).length,
+        'writer'
+      )} · ${ago(view.syncedAt)}`
+    : 'never'
+
+/** Shown under a result when the newest sync failed and the result uses the one before it. */
+export const staleLine = (view: TocsinView) =>
+  view.sync && view.status?.error
+    ? `The last sync failed (${view.status.error}); this result uses the sync before it.`
+    : undefined
+
+/** Followed lists left out of this check, and a chain that is not the log's. Warning-coloured lines. */
+export function notes(view: TocsinView, chainId: bigint): string[] {
+  const left = view.lists
+    .filter((l) => l.followed && !usable(l))
+    .map(
+      (l) =>
+        `${l.name} (${
+          l.pending ? 'its maintainer changed; review it in Tocsin' : 'no verified list yet'
+        })`
+    )
+  return [
+    ...(left.length > 0 ? [`Not checked: ${left.join(', ')}.`] : []),
+    ...(chainId !== LOG_CHAIN_ID
+      ? [
+          `This request is on chain ${chainId}, not Sepolia. Only flags written for chain ${chainId} or for every chain count here.`
+        ]
+      : [])
+  ]
+}
+
+export type Cause = { title: string; body: string }
+
+/** Why a result is unverifiable: the info banner's title and body (snap-ui spec 3.5). */
+export function causeOf(
+  view: TocsinView,
+  assessments: readonly TocsinAssessment[] | undefined
+): Cause {
+  const last = view.lastGood
+    ? `Last good sync ${ago(view.lastGood.at)} at block ${num(view.lastGood.block)}.`
+    : 'No good sync yet.'
+  const rpc = host(view.settings.rpcUrl)
+  if (!view.sync) {
+    if (view.isSyncing) {
+      const n = view.lists.filter((l) => l.followed).length
+      return {
+        title: 'First sync in progress',
+        body: `Downloading flags for ${plural(n, 'list')}. Usually under a minute.`
+      }
+    }
+    return {
+      title: 'Tocsin has not synced yet',
+      body: `${
+        view.status?.error ? `${view.status.error}. ` : ''
+      }Open Tocsin in Settings and press Sync now.`
+    }
+  }
+  if (!assessments || !view.lists.some(usable))
+    return { title: 'No list to check against', body: 'Follow a list in Tocsin settings.' }
+  const s = view.sync
+  const ws = unique(assessments.flatMap((a) => a.unavailable)).map((w) => s.writers[w])
+  if (ws.some((w) => w?.status === 'unavailable' && w.divergedAt !== undefined)) {
+    return {
+      title: "The RPC's data does not match Ethereum",
+      body: `Replayed the flags from ${rpc} and they did not reach the head proven at block ${num(
+        s.block.number
+      )}. One or more flags are missing or altered. Switch RPC in Tocsin settings.`
+    }
+  }
+  const failed = ws.find((w) => w?.status === 'unavailable')
+  if (failed) return { title: `Could not reach ${rpc}`, body: `${whyUnavailable(failed)}. ${last}` }
+  return { title: 'Not every writer synced', body: last }
+}
+
+/** The banner for one flagged address (snap-ui spec 3.2 and 3.3): danger on block, warning on warn. */
+export function flagBanner(a: TocsinAssessment): Cause {
+  const block = a.verdict === 'block'
+  const cats = unique(a.findings.map((f) => f.category)).map(category)
+  const writers = unique(a.findings.map((f) => f.writer))
+  const lists = unique(a.findings.map((f) => f.list).filter(Boolean))
+  const why = block
+    ? ''
+    : a.findings.every((f) => f.category === 8) && a.target.context === 'recipient'
+    ? ' Theft proceeds are a warning by policy; this category is meant for exchanges and bridges, not send screens.'
+    : ' Your list blocks only on a weight-255 writer or two independent writers.'
+  const first = cats[0] ?? category(0)
+  return {
+    title: first.title,
+    body: `${first.desc} Flagged by ${plural(writers.length, 'writer')} on ${lists.join(
+      ', '
+    )}.${why}`
+  }
+}
+
+/** "manual.tocsin.eth · via tocsin.eth" per distinct writer and list. */
+export const flaggedBy = (view: TocsinView, a: TocsinAssessment) =>
+  unique(a.findings.map((f) => `${writerLabel(view, f.writer)} · via ${f.list}`))
+
+/** "block 11,482,100 · 2 h ago" for the earliest finding, against the proven head. */
+export function seenLine(view: TocsinView, a: TocsinAssessment): string {
+  if (a.findings.length === 0) return ''
+  const seen = a.findings.reduce(
+    (m, f) => (f.seenBlock < m ? f.seenBlock : m),
+    a.findings[0]!.seenBlock
+  )
+  const head = view.sync?.block.number
+  const seenAgo =
+    head !== undefined && seen <= head ? ` · ${ago(0, Number(head - seen) * 12_000)}` : ''
+  return `block ${num(seen)}${seenAgo}`
+}
+
+/** The panel heading per verdict. "Clean" is never the word on screen. */
+export const verdictTitle = (v: Verdict | 'checking') =>
+  ({
+    block: 'Blocked',
+    warn: 'Warning',
+    clean: 'No flags',
+    unavailable: 'Unverifiable',
+    checking: 'Checking'
+  }[v])
+
+/** The "No flags" subtitle: what was checked and when. */
+export const cleanLine = (view: TocsinView) =>
+  `Checked against ${plural(view.lists.filter(usable).length, 'list')}, ${num(
+    view.sync?.flags ?? 0
+  )} flags, synced ${view.syncedAt ? ago(view.syncedAt) : 'never'}.`
+
+export const CHECKING_LINE = 'Tocsin is still syncing. This address is not checked yet.'
+export const UNVERIFIABLE_LINE =
+  'Tocsin could not verify the flag log. Treat this address as unchecked.'
+
+/** One line for the send screen: the recipient field's message for each verdict. */
+export function recipientLine(
+  view: TocsinView,
+  a: TocsinAssessment | undefined,
+  checking: boolean
+): string {
+  if (checking || !a) return CHECKING_LINE
+  if (a.verdict === 'block') {
+    const b = flagBanner(a)
+    return `Tocsin blocked this recipient: ${b.title}. ${b.body}`
+  }
+  if (a.verdict === 'warn')
+    return `Tocsin warning: ${flagBanner(a).title}. Check this address before you send.`
+  if (a.verdict === 'clean') return `No flags. ${cleanLine(view)}`
+  return UNVERIFIABLE_LINE
+}
diff --git a/src/libs/tocsin/engine.ts b/src/libs/tocsin/engine.ts
new file mode 100644
index 000000000..93184da7a
--- /dev/null
+++ b/src/libs/tocsin/engine.ts
@@ -0,0 +1,307 @@
+// The reader wired to Kohaku: one fetch-based RPC for header, proofs, ENS and leaves. Ported from
+// the antibody Snap (dapp/packages/snap/src/engine.ts); `fetch` is passed in instead of global.
+import { type Hex, getAddress, isHex } from 'viem'
+
+import type { Target } from './decode'
+import {
+  type EthCall,
+  type Evaluation,
+  type RpcRequest,
+  type SyncResult,
+  type VerifiedList,
+  acceptList,
+  decodeListRecord,
+  evaluate,
+  resolveListRecord,
+  reverseName,
+  rpcLeafSource,
+  rpcProofSource,
+  sync
+} from './reader'
+import {
+  FROM_BLOCK,
+  LOG,
+  LOG_CHAIN_ID,
+  type ListState,
+  RECORD_OVERRIDES,
+  type State
+} from './state'
+
+export type FetchFn = typeof globalThis.fetch
+
+const TIMEOUT_MS = 20_000
+
+async function fetchWithTimeout(
+  fetch: FetchFn,
+  url: string,
+  init?: RequestInit
+): Promise<Response> {
+  const ctl = new AbortController()
+  const timer = setTimeout(() => ctl.abort(), TIMEOUT_MS)
+  try {
+    const res = await fetch(url, { ...init, signal: ctl.signal })
+    if (!res.ok) throw new Error(`HTTP ${res.status} from ${new URL(url).host}`)
+    return res
+  } catch (error) {
+    throw new Error(`request to ${new URL(url).host} failed`, { cause: error })
+  } finally {
+    clearTimeout(timer)
+  }
+}
+
+let rpcId = 0
+/** A plain JSON-RPC client over fetch. Bypasses Kohaku's providers (no Colibri, no Helios). */
+export function rpcRequest(url: string, fetch: FetchFn): RpcRequest {
+  return async ({ method, params = [] }) => {
+    const res = await fetchWithTimeout(fetch, url, {
+      method: 'POST',
+      headers: { 'content-type': 'application/json' },
+      body: JSON.stringify({ jsonrpc: '2.0', id: ++rpcId, method, params })
+    })
+    const body = (await res.json()) as { result?: unknown; error?: { message?: string } }
+    if (body.error) throw new Error(`${method}: ${body.error.message ?? 'RPC error'}`)
+    return body.result
+  }
+}
+
+const ethCall =
+  (request: RpcRequest): EthCall =>
+  async ({ to, data }) => {
+    const out = await request({ method: 'eth_call', params: [{ to, data }, 'latest'] })
+    if (!isHex(out)) throw new Error('eth_call did not return hex')
+    return out
+  }
+
+/** The current record and document for a list name, or undefined when either cannot be fetched (acceptList then reports stale). */
+async function fetchList(
+  name: string,
+  call: EthCall,
+  fetch: FetchFn
+): Promise<{ record: Hex; document: unknown } | undefined> {
+  const record = RECORD_OVERRIDES[name] ?? (await resolveListRecord(call, name))
+  if (!record) return undefined
+  try {
+    const { listURI } = decodeListRecord(record)
+    return { record, document: await (await fetchWithTimeout(fetch, listURI)).json() }
+  } catch {
+    return undefined // undecodable record or unreachable document: unverifiable, keep the pin
+  }
+}
+
+type Usable = { next: ListState; list?: VerifiedList }
+
+/**
+ * Applies acceptList's pinning to one list name. A list signed by a new maintainer is held in
+ * `pending` and the list is excluded until the user accepts it; no prompt here, so a timer tick
+ * never interrupts the user.
+ */
+async function syncList(
+  name: string,
+  prev: ListState,
+  call: EthCall,
+  fetch: FetchFn
+): Promise<Usable> {
+  const outcome = await acceptList({
+    kind: 'list',
+    log: LOG,
+    chainId: LOG_CHAIN_ID,
+    fetched: await fetchList(name, call, fetch),
+    ...(prev.pinned && { pinned: prev.pinned })
+  })
+  if (outcome.status === 'conflict')
+    return { next: { ...prev, pending: outcome.candidate.signed, status: 'maintainer changed' } }
+  const { pending: _, ...rest } = prev
+  const next: ListState = {
+    ...rest,
+    status: outcome.status === 'rejected' ? `rejected (${outcome.reason})` : outcome.status,
+    ...(outcome.status === 'accepted' && { pinned: outcome.list.signed })
+  }
+  return { next, ...(outcome.list && 'entries' in outcome.list.list && { list: outcome.list }) }
+}
+
+/** Live and dead FLAG leaves across synced writers: what "N flags" means on screen. */
+export const flagCount = (s: SyncResult): number =>
+  Object.values(s.writers).reduce(
+    (n, w) => n + (w.status === 'synced' ? w.leaves.filter((l) => l.leaf.op === 0).length : 0),
+    0
+  )
+
+export const errorText = (error: unknown): string =>
+  error instanceof Error
+    ? error.cause instanceof Error
+      ? `${error.message}: ${error.cause.message}`
+      : error.message
+    : String(error)
+
+/** Writer errors as their message, so the result stores and crosses the UI port as plain JSON. */
+const plainErrors = (s: SyncResult): SyncResult => ({
+  ...s,
+  writers: Object.fromEntries(
+    Object.entries(s.writers).map(([k, w]) => [
+      k,
+      w.status === 'unavailable' && w.error !== undefined ? { ...w, error: errorText(w.error) } : w
+    ])
+  )
+})
+
+/**
+ * Resolves and pins every followed list, proves every listed writer's head through the RPC in one
+ * call, syncs leaves from the same RPC, and returns the next state. Never throws: failures land in
+ * `status.error`.
+ */
+export async function runSync(state: State, fetch: FetchFn): Promise<State> {
+  const { rpcUrl } = state.settings
+  const at = Date.now()
+  const followed = Object.keys(state.lists).filter((n) => state.lists[n]!.followed)
+  if (followed.length === 0) return { ...state, status: { at, error: 'follow at least one list' } }
+  try {
+    const request = rpcRequest(rpcUrl, fetch)
+    const call = ethCall(request)
+    const chainId = await request({ method: 'eth_chainId' })
+    if (!isHex(chainId) || BigInt(chainId) !== LOG_CHAIN_ID)
+      throw new Error(
+        `the RPC at ${new URL(rpcUrl).host} is not Sepolia (chain ${String(chainId)})`
+      )
+    const lists = { ...state.lists }
+    const verified: VerifiedList[] = []
+    for (const name of followed) {
+      // eslint-disable-next-line no-await-in-loop
+      const { next, list } = await syncList(name, lists[name]!, call, fetch)
+      lists[name] = next
+      if (list) verified.push(list)
+    }
+    const base = { ...state, lists }
+    if (verified.length === 0)
+      return { ...base, status: { at, error: 'no usable list for the followed names yet' } }
+
+    // A writer on two lists is proved and synced once.
+    const writers = [
+      ...new Set(
+        verified.flatMap((l) =>
+          'entries' in l.list ? l.list.entries.map((e) => getAddress(e.writer)) : []
+        )
+      )
+    ]
+    const checkpoints = { ...state.checkpoints }
+    const result = plainErrors(
+      await sync({
+        log: LOG,
+        writers: writers.map((writer) => ({ writer })),
+        proofs: rpcProofSource({ request }),
+        leaves: rpcLeafSource({ request, log: LOG, fromBlock: FROM_BLOCK }),
+        checkpoints: {
+          get: async (k) => checkpoints[k],
+          set: async (k, v) => {
+            checkpoints[k] = v
+          }
+        }
+      })
+    )
+    const names = { ...state.names }
+    await Promise.all(
+      Object.keys(result.writers).map(async (w) => {
+        const name = await reverseName(call, getAddress(w))
+        if (name) names[getAddress(w)] = name
+        else delete names[getAddress(w)]
+      })
+    )
+    const all = Object.values(result.writers)
+    const lastGood = all.every((w) => w.status === 'synced')
+      ? { flags: flagCount(result), writers: all.length, block: result.block.number, at }
+      : state.lastGood
+    return {
+      ...base,
+      checkpoints,
+      sync: result,
+      syncedAt: at,
+      names,
+      status: { at },
+      ...(lastGood && { lastGood })
+    }
+  } catch (error) {
+    return { ...state, status: { at, error: errorText(error) } }
+  }
+}
+
+/** A changed RPC drops checkpoints so the next sync replays the new source from genesis instead of trusting the old one's tail. */
+export const clearCheckpoints = (state: State): State => ({ ...state, checkpoints: {} })
+
+/** A list a user is about to add: fetched and verified, not pinned yet. */
+export async function fetchCandidate(
+  state: State,
+  name: string,
+  fetch: FetchFn
+): Promise<VerifiedList | string> {
+  try {
+    const call = ethCall(rpcRequest(state.settings.rpcUrl, fetch))
+    const outcome = await acceptList({
+      kind: 'list',
+      log: LOG,
+      chainId: LOG_CHAIN_ID,
+      fetched: await fetchList(name, call, fetch)
+    })
+    if (outcome.status === 'accepted' && 'entries' in outcome.list.list) return outcome.list
+    return outcome.status === 'rejected'
+      ? `The list at ${name} failed verification (${outcome.reason}).`
+      : `No Tocsin list found at ${name}.`
+  } catch (error) {
+    return `Could not read ${name}: ${errorText(error)}.`
+  }
+}
+
+/** Every finding's list name, in `evaluation.findings` order. */
+export type Assessment = { target: Target; evaluation: Evaluation; listOf: string[] }
+
+export type NamedList = { name: string; list: VerifiedList }
+
+/** Followed lists with an accepted pin and no pending maintainer change, re-verified from state. */
+export async function pinnedLists(state: State): Promise<NamedList[]> {
+  const out: NamedList[] = []
+  for (const [name, l] of Object.entries(state.lists)) {
+    if (!l.followed || !l.pinned || l.pending) continue
+    // eslint-disable-next-line no-await-in-loop
+    const { list } = await acceptList({
+      kind: 'list',
+      log: LOG,
+      chainId: LOG_CHAIN_ID,
+      pinned: l.pinned
+    })
+    if (list && 'entries' in list.list) out.push({ name, list })
+  }
+  return out
+}
+
+/** The verified list a pin holds, for showing its maintainer and writers. */
+export async function verifiedPin(pinned: ListState['pinned']): Promise<VerifiedList | undefined> {
+  if (!pinned) return undefined
+  return (
+    await acceptList({ kind: 'list', log: LOG, chainId: LOG_CHAIN_ID, pinned }).catch(
+      () => undefined
+    )
+  )?.list
+}
+
+/** Evaluates each target against the last sync. Undefined when there is nothing to evaluate against yet. */
+export async function assess(
+  state: State,
+  targets: readonly Target[],
+  chainId: bigint
+): Promise<Assessment[] | undefined> {
+  const lists = await pinnedLists(state)
+  if (lists.length === 0 || !state.sync) return undefined
+  const s = state.sync
+  return targets.map((target) => {
+    const evaluation = evaluate({
+      subject: target.address,
+      context: target.context,
+      sync: s,
+      // Every followed list is marked blocking (spec, Trust lists); escalation is OR across them.
+      lists: lists.map(({ list }) => ({ list, blocking: true })),
+      safelists: [],
+      logChainId: LOG_CHAIN_ID,
+      chainId
+    })
+    const listOf = evaluation.findings.map((f) => lists.find((l) => l.list === f.list)?.name ?? '')
+    return { target, evaluation, listOf }
+  })
+}
