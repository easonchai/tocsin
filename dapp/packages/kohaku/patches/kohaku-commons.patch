@@ -0,0 +1,108 @@
+// The send-screen hard block: a tocsin block verdict fails recipient validation; nothing else does.
+import { expect } from '@jest/globals'
+
+import { produceMemoryStore } from '../../../test/helpers'
+import { CLEAN, DRAINER, fakeFetch, signedList, world } from '../../../test/helpers/tocsin'
+import { StorageController } from '../storage/storage'
+import { TocsinController } from '../tocsin/tocsin'
+import { TransferController } from './transfer'
+
+const OWN = '0x00000000000000000000000000000000000000aa'
+
+const until = async (cond: () => boolean) => {
+  for (let i = 0; i < 200 && !cond(); i++) {
+    // eslint-disable-next-line no-await-in-loop
+    await new Promise((r) => setTimeout(r, 5))
+  }
+  if (!cond()) throw new Error('condition not met')
+}
+
+function transferWith(tocsin: TocsinController) {
+  const stub = {} as any
+  return new TransferController(
+    new StorageController(produceMemoryStore()),
+    { knownAddresses: {} } as any,
+    {
+      account: { addr: OWN, associatedKeys: [OWN], creation: null },
+      initialLoadPromise: Promise.resolve()
+    } as any,
+    { networks: [{ chainId: 11155111n }] } as any,
+    // Both recipients are known contacts, so only tocsin can fail them.
+    { contacts: [{ address: DRAINER }, { address: CLEAN }] } as any,
+    stub,
+    stub,
+    stub,
+    stub,
+    {},
+    stub,
+    '',
+    tocsin
+  )
+}
+
+const to = (fieldValue: string) => ({
+  addressState: { fieldValue, ensAddress: '', isDomainResolving: false }
+})
+
+describe('TransferController with tocsin', () => {
+  test('a block verdict fails recipientAddress with the block message; a clean address passes', async () => {
+    world.lists = { 'tocsin.eth': await signedList(`0x${'a1'.repeat(32)}`, 1n) }
+    const tocsin = new TocsinController({
+      storage: new StorageController(produceMemoryStore()),
+      fetch: fakeFetch
+    })
+    await tocsin.updateSettings({ rpcUrl: 'https://rpc.test' })
+    await tocsin.addList('tocsin.eth')
+    await tocsin.confirmAddList()
+    const transfer = transferWith(tocsin)
+
+    await transfer.update(to(DRAINER))
+    await until(() => transfer.tocsinRecipient?.verdict === 'block')
+    expect(transfer.validationFormMsgs.recipientAddress.success).toBe(false)
+    expect(transfer.validationFormMsgs.recipientAddress.message).toMatch(
+      /^Tocsin blocked this recipient: Drainer receiver\./
+    )
+    expect(transfer.isFormValid).toBe(false)
+    expect(transfer.toJSON().tocsinRecipient?.verdict).toBe('block')
+
+    await transfer.update(to(CLEAN))
+    await until(() => transfer.tocsinRecipient?.verdict === 'clean')
+    // The module-level default messages were not mutated by the block.
+    expect(transfer.validationFormMsgs.recipientAddress).toEqual({ success: true, message: '' })
+  })
+
+  test('while the first sync runs the recipient is "checking" and is not blocked', async () => {
+    world.lists = { 'tocsin.eth': await signedList(`0x${'a1'.repeat(32)}`, 1n) }
+    let release = () => {}
+    const gate = new Promise<void>((r) => {
+      release = r
+    })
+    const storage = new StorageController(produceMemoryStore())
+    // A pinned list from an earlier run, but no sync yet: the case right after install.
+    const seeded = new TocsinController({ storage, fetch: fakeFetch })
+    await seeded.updateSettings({ rpcUrl: 'https://rpc.test' })
+    await seeded.addList('tocsin.eth')
+    await seeded.confirmAddList()
+    const raw = await storage.get('tocsin', null)
+    await storage.set('tocsin', { ...raw, sync: undefined, syncedAt: undefined, checkpoints: {} })
+
+    const tocsin = new TocsinController({
+      storage,
+      fetch: async (i, init) => {
+        await gate
+        return fakeFetch(i, init)
+      }
+    })
+    const transfer = transferWith(tocsin)
+    await tocsin.initialLoadPromise
+    const syncing = tocsin.syncNow()
+    await transfer.update(to(DRAINER))
+    expect(tocsin.isSyncing).toBe(true)
+    expect(transfer.tocsinRecipient?.verdict).toBe('checking')
+    expect(transfer.validationFormMsgs.recipientAddress.success).toBe(true)
+    release()
+    await syncing
+    await until(() => transfer.tocsinRecipient?.verdict === 'block')
+    expect(transfer.validationFormMsgs.recipientAddress.success).toBe(false)
+  })
+})
