index 000000000..714bbaa0e
--- /dev/null
+++ b/src/controllers/tocsin/tocsin.ts
@@ -0,0 +1,432 @@
+import { type Address, getAddress, isAddress } from 'viem'
+
+import type { Target } from '../../libs/tocsin/decode'
+import {
+  assessmentKey,
+  type ListSummary,
+  type ListView,
+  type SyncView,
+  type TocsinAssessment,
+  type TocsinView,
+  type WriterView
+} from '../../libs/tocsin/display'
+import {
+  assess as engineAssess,
+  type Assessment,
+  clearCheckpoints,
+  errorText,
+  fetchCandidate,
+  type FetchFn,
+  flagCount,
+  runSync,
+  verifiedPin
+} from '../../libs/tocsin/engine'
+import type { SyncResult, VerifiedList } from '../../libs/tocsin/reader'
+import { parseListName, parseRpcUrl } from '../../libs/tocsin/settings'
+import {
+  fromStored,
+  type LastGood,
+  type ListState,
+  type Settings,
+  type State,
+  STORAGE_KEY,
+  type SyncStatus
+} from '../../libs/tocsin/state'
+import EventEmitter from '../eventEmitter/eventEmitter'
+// eslint-disable-next-line import/no-cycle
+import { StorageController } from '../storage/storage'
+
+/** The Snap's cron interval (`*\/5 * * * *`). */
+export const TOCSIN_SYNC_INTERVAL_MS = 5 * 60 * 1000
+
+/** Assessments kept in memory for the synchronous getter. Never persisted. */
+const MAX_CACHED_ASSESSMENTS = 100
+
+export type TocsinFormErrors = { rpcUrl?: string; listName?: string }
+
+export type AddListCandidate = { name: string } & ListSummary
+
+const summary = (l: VerifiedList | undefined): ListSummary | undefined =>
+  l && {
+    maintainer: l.maintainer,
+    version: l.version,
+    writers: 'entries' in l.list ? l.list.entries.map((e) => getAddress(e.writer)) : []
+  }
+
+const syncView = (s: SyncResult): SyncView => ({
+  block: {
+    number: s.block.number,
+    hash: s.block.hash,
+    ...(s.block.unverified && { unverified: true })
+  },
+  flags: flagCount(s),
+  writers: Object.fromEntries(
+    Object.entries(s.writers).map(([k, w]) => {
+      // SAFETY: engine.ts stores writer errors as their message.
+      const view: WriterView =
+        w.status === 'synced'
+          ? { status: w.status, writer: w.writer, seq: w.seq, head: w.head }
+          : {
+              status: w.status,
+              writer: w.writer,
+              seq: w.seq,
+              head: w.head,
+              ...(w.divergedAt !== undefined && { divergedAt: w.divergedAt }),
+              ...(w.error !== undefined && { error: String(w.error) })
+            }
+      return [k, view]
+    })
+  )
+})
+
+const toAssessment = (a: Assessment, chainId: bigint): TocsinAssessment => ({
+  target: a.target,
+  chainId,
+  verdict: a.evaluation.verdict,
+  findings: a.evaluation.findings.map((f, i) => ({
+    writer: f.writer,
+    category: f.category,
+    evidence: f.evidence,
+    seenBlock: f.leaf.leaf.seenBlock,
+    weight: f.weight,
+    list: a.listOf[i] ?? ''
+  })),
+  unavailable: a.evaluation.unavailable
+})
+
+const unavailable = (target: Target, chainId: bigint): TocsinAssessment => ({
+  target,
+  chainId,
+  verdict: 'unavailable',
+  findings: [],
+  unavailable: []
+})
+
+/** Targets from the UI port: checksummed, known context, anything else dropped. */
+const cleanTargets = (targets: readonly Target[]): Target[] =>
+  (Array.isArray(targets) ? targets : [])
+    .filter((t) => typeof t?.address === 'string' && isAddress(t.address, { strict: false }))
+    .map((t) => {
+      const context = t.context === 'spender' || t.context === 'delegate' ? t.context : 'recipient'
+      return {
+        address: getAddress(t.address),
+        context,
+        why: typeof t.why === 'string' ? t.why : context
+      }
+    })
+
+/**
+ * The tocsin reader in the background: lists, sync and verdicts, ported from the antibody Snap.
+ * Same trust level as the Snap: header and proofs from one RPC, best effort, not a light client.
+ * Evaluated addresses live only in memory (`assessments`) and are never written to storage.
+ */
+export class TocsinController extends EventEmitter implements TocsinView {
+  #storage: StorageController
+
+  #fetch: FetchFn
+
+  #state: State = fromStored(null)
+
+  /** Every mutation runs here in order, so a timer sync and a user action never overwrite each other. */
+  #queue: Promise<unknown> = Promise.resolve()
+
+  #queuedSync: Promise<void> | null = null
+
+  #candidate: { name: string; list: VerifiedList } | null = null
+
+  settings: Settings = this.#state.settings
+
+  lists: ListView[] = []
+
+  sync: SyncView | null = null
+
+  syncedAt: number | null = null
+
+  lastGood: LastGood | null = null
+
+  names: Record<Address, string> = {}
+
+  status: SyncStatus | null = null
+
+  isSyncing = false
+
+  isReady = false
+
+  /** Keyed by `assessmentKey(target, chainId)`. Recomputed after every sync and list change. */
+  assessments: Record<string, TocsinAssessment> = {}
+
+  /** A verified list waiting for `confirmAddList` or `cancelAddList` (the Snap's confirm dialog). */
+  addListCandidate: AddListCandidate | null = null
+
+  isFetchingCandidate = false
+
+  formErrors: TocsinFormErrors = {}
+
+  // Holds the initial load promise, so that one can wait until it completes
+  initialLoadPromise: Promise<void>
+
+  constructor({ storage, fetch }: { storage: StorageController; fetch: FetchFn }) {
+    super()
+
+    this.#storage = storage
+    this.#fetch = fetch
+
+    // First in the queue, so no action can run on the defaults and be overwritten by the load.
+    this.initialLoadPromise = this.#run(() => this.#load())
+  }
+
+  async #load() {
+    try {
+      await this.#publish(fromStored(await this.#storage.get(STORAGE_KEY, null)))
+    } catch (error) {
+      this.emitError({
+        level: 'minor',
+        message: 'Tocsin could not load its saved lists. It starts from the defaults.',
+        error: new Error('tocsin: load failed', { cause: error })
+      })
+      await this.#publish(fromStored(null))
+    }
+    this.isReady = true
+    this.emitUpdate()
+  }
+
+  #run<T>(op: () => Promise<T>): Promise<T> {
+    const next = this.#queue.then(op)
+    this.#queue = next.catch(() => undefined)
+    return next
+  }
+
+  /** Sets the state, derives the public fields, and re-evaluates cached targets. */
+  async #publish(next: State) {
+    this.#state = next
+    this.settings = next.settings
+    this.lists = await Promise.all(
+      Object.entries(next.lists).map(async ([name, l]) => {
+        const pinned = summary(await verifiedPin(l.pinned))
+        const pending = summary(await verifiedPin(l.pending))
+        return {
+          name,
+          followed: l.followed,
+          ...(l.status !== undefined && { status: l.status }),
+          ...(pinned && { pinned }),
+          ...(pending && { pending })
+        }
+      })
+    )
+    this.sync = next.sync ? syncView(next.sync) : null
+    this.syncedAt = next.syncedAt ?? null
+    this.lastGood = next.lastGood ?? null
+    this.names = next.names
+    this.status = next.status ?? null
+    await this.#reassess()
+  }
+
+  async #commit(next: State) {
+    await this.#publish(next)
+    await this.#storage.set(STORAGE_KEY, next)
+    this.emitUpdate()
+  }
+
+  #setList(name: string, l: ListState): State {
+    return { ...this.#state, lists: { ...this.#state.lists, [name]: l } }
+  }
+
+  /** Runs one sync now, or joins the one already queued. Never throws: failures land in `status`. */
+  syncNow(): Promise<void> {
+    if (!this.#queuedSync) {
+      this.#queuedSync = this.#run(async () => {
+        this.#queuedSync = null
+        await this.initialLoadPromise
+        this.isSyncing = true
+        this.emitUpdate()
+        try {
+          await this.#commit(await runSync(this.#state, this.#fetch))
+        } catch (error) {
+          // runSync never throws; this is storage or re-evaluation failing.
+          this.emitError({
+            level: 'minor',
+            message: 'Tocsin could not save its last sync.',
+            error: new Error('tocsin: sync commit failed', { cause: error })
+          })
+        } finally {
+          this.isSyncing = false
+          this.emitUpdate()
+        }
+      })
+    }
+    return this.#queuedSync
+  }
+
+  async #evaluate(targets: Target[], chainId: bigint): Promise<TocsinAssessment[]> {
+    try {
+      const result = await engineAssess(this.#state, targets, chainId)
+      return result
+        ? result.map((a) => toAssessment(a, chainId))
+        : targets.map((t) => unavailable(t, chainId))
+    } catch (error) {
+      this.emitError({
+        level: 'silent',
+        message: 'Tocsin could not evaluate an address.',
+        error: new Error(`tocsin: evaluate failed: ${errorText(error)}`, { cause: error })
+      })
+      return targets.map((t) => unavailable(t, chainId))
+    }
+  }
+
+  async #reassess() {
+    const entries = Object.values(this.assessments)
+    const fresh = await Promise.all(entries.map((a) => this.#evaluate([a.target], a.chainId)))
+    this.assessments = Object.fromEntries(
+      fresh.flat().map((a) => [assessmentKey(a.target, a.chainId), a])
+    )
+  }
+
+  /**
+   * Evaluates targets against the last sync and caches each result for `getAssessment`. Never
+   * throws; an address it cannot evaluate gets `unavailable`. Kept in memory only.
+   */
+  async assess(targets: readonly Target[], chainId: bigint): Promise<TocsinAssessment[]> {
+    await this.initialLoadPromise
+    const clean = cleanTargets(targets)
+    const chain = BigInt(chainId)
+    const results = await this.#evaluate(clean, chain)
+    const merged = {
+      ...this.assessments,
+      ...Object.fromEntries(results.map((a) => [assessmentKey(a.target, chain), a]))
+    }
+    // shortcut: drops the oldest keys past 100; an LRU is not worth it for one send screen.
+    const keys = Object.keys(merged)
+    this.assessments = Object.fromEntries(
+      keys.slice(Math.max(0, keys.length - MAX_CACHED_ASSESSMENTS)).map((k) => [k, merged[k]!])
+    )
+    this.emitUpdate()
+    return results
+  }
+
+  /** The cached result of `assess`, or undefined when it has not finished for this target. */
+  getAssessment(
+    target: Pick<Target, 'address' | 'context'>,
+    chainId: bigint
+  ): TocsinAssessment | undefined {
+    return this.assessments[assessmentKey(target, chainId)]
+  }
+
+  /** The Snap's Network form: a new RPC drops checkpoints and replays from genesis. */
+  async updateSettings({ rpcUrl }: { rpcUrl: string }) {
+    const parsed = parseRpcUrl(rpcUrl)
+    if ('error' in parsed) {
+      this.formErrors = { ...this.formErrors, rpcUrl: parsed.error }
+      this.emitUpdate()
+      return
+    }
+    const { rpcUrl: _, ...rest } = this.formErrors
+    this.formErrors = rest
+    await this.#run(async () => {
+      const s = this.#state
+      await this.#commit(
+        parsed.url === s.settings.rpcUrl
+          ? s
+          : clearCheckpoints({ ...s, settings: { ...s.settings, rpcUrl: parsed.url } })
+      )
+    })
+    await this.syncNow()
+  }
+
+  /** Unfollowing keeps the pin and the writers' flags; following again syncs. */
+  async setFollowed(name: string, followed: boolean) {
+    const changed = await this.#run(async () => {
+      const l = this.#state.lists[name]
+      if (!l) return false
+      await this.#commit(this.#setList(name, { ...l, followed }))
+      return true
+    })
+    if (changed && followed) await this.syncNow()
+  }
+
+  async removeList(name: string) {
+    await this.#run(async () => {
+      if (!this.#state.lists[name]) return
+      const { [name]: _, ...lists } = this.#state.lists
+      await this.#commit({ ...this.#state, lists })
+    })
+  }
+
+  /** Step one of "Add a list by ENS name": resolve, fetch and verify; the UI then confirms or cancels. */
+  async addList(rawName: string) {
+    await this.initialLoadPromise
+    const parsed = parseListName(rawName)
+    const fail = (listName: string) => {
+      this.formErrors = { ...this.formErrors, listName }
+      this.emitUpdate()
+    }
+    if ('error' in parsed) return fail(parsed.error)
+    if (this.#state.lists[parsed.name]) return fail(`${parsed.name} is already in your lists.`)
+    const { listName: _, ...rest } = this.formErrors
+    this.formErrors = rest
+    this.#candidate = null
+    this.addListCandidate = null
+    this.isFetchingCandidate = true
+    this.emitUpdate()
+    try {
+      const list = await fetchCandidate(this.#state, parsed.name, this.#fetch)
+      if (typeof list === 'string') return fail(list)
+      this.#candidate = { name: parsed.name, list }
+      this.addListCandidate = { name: parsed.name, ...summary(list)! }
+    } finally {
+      this.isFetchingCandidate = false
+      this.emitUpdate()
+    }
+  }
+
+  /** Step two: pin the candidate's maintainer (first-use pinning) and sync. */
+  async confirmAddList() {
+    const candidate = this.#candidate
+    this.#candidate = null
+    this.addListCandidate = null
+    if (!candidate) return this.emitUpdate()
+    const added = await this.#run(async () => {
+      if (this.#state.lists[candidate.name]) return false
+      await this.#commit(
+        this.#setList(candidate.name, {
+          followed: true,
+          pinned: candidate.list.signed,
+          status: 'accepted'
+        })
+      )
+      return true
+    })
+    if (added) await this.syncNow()
+    else this.emitUpdate()
+  }
+
+  cancelAddList() {
+    this.#candidate = null
+    this.addListCandidate = null
+    this.emitUpdate()
+  }
+
+  /** The Snap's Review dialog accepted: the pending maintainer becomes the pin, then sync. */
+  async acceptMaintainerChange(name: string) {
+    const accepted = await this.#run(async () => {
+      const l = this.#state.lists[name]
+      if (!l?.pending) return false
+      const { pending, ...rest } = l
+      await this.#commit(
+        this.#setList(name, {
+          ...rest,
+          pinned: pending,
+          status: 'accepted, new maintainer confirmed'
+        })
+      )
+      return true
+    })
+    if (accepted) await this.syncNow()
+  }
+
+  toJSON() {
+    return {
+      ...this,
+      ...super.toJSON()
+    }
+  }
+}
