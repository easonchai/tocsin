diff --git a/src/controllers/signAccountOp/signAccountOpTocsin.test.ts b/src/controllers/signAccountOp/signAccountOpTocsin.test.ts
new file mode 100644
index 000000000..90c093bfe
--- /dev/null
+++ b/src/controllers/signAccountOp/signAccountOpTocsin.test.ts
@@ -0,0 +1,152 @@
+// dApp transactions: a tocsin block on any target (the `to` or a decoded spender) stops signing.
+import { encodeFunctionData, parseAbi } from 'viem'
+
+import { expect } from '@jest/globals'
+
+import { produceMemoryStore } from '../../../test/helpers'
+import { CLEAN, fakeFetch, signedList, SPENDER, world } from '../../../test/helpers/tocsin'
+import { testnetNetworks } from '../../consts/testnetNetworks'
+import { BLOCKED_SEND_LINE } from '../../libs/tocsin/check'
+import { StorageController } from '../storage/storage'
+import { TocsinController } from '../tocsin/tocsin'
+import { SignAccountOpController, SigningStatus } from './signAccountOp'
+
+const OWN = '0x00000000000000000000000000000000000000aa'
+const sepolia = testnetNetworks.find((n) => n.chainId === 11155111n)!
+
+const until = async (cond: () => boolean) => {
+  for (let i = 0; i < 200 && !cond(); i++) {
+    // eslint-disable-next-line no-await-in-loop
+    await new Promise((r) => {
+      setTimeout(r, 5)
+    })
+  }
+  if (!cond()) throw new Error('condition not met')
+}
+
+async function syncedTocsin() {
+  world.lists = { 'tocsin.eth': await signedList(`0x${'a1'.repeat(32)}`, 1n) }
+  const tocsin = new TocsinController({
+    storage: new StorageController(produceMemoryStore()),
+    fetch: fakeFetch
+  })
+  await tocsin.updateSettings({ rpcUrl: 'https://rpc.test' })
+  await tocsin.addList('tocsin.eth')
+  await tocsin.confirmAddList()
+  return tocsin
+}
+
+/** Records every signer request, so a test can show signing never reached the keystore. */
+const recordingKeystore = () => {
+  const signerRequests: string[] = []
+  return {
+    signerRequests,
+    keys: [],
+    getSigner: async (addr: string) => {
+      signerRequests.push(addr)
+      throw new Error('no signer in this test')
+    }
+  }
+}
+
+function signAccountOpWith(
+  tocsin: TocsinController,
+  keystore: ReturnType<typeof recordingKeystore>,
+  calls: { to: string; value: bigint; data: string }[]
+) {
+  // Estimation and gas prices never finish here, so the only thing between the op and signing is tocsin.
+  const never = () => new Promise(() => {})
+  const provider = { send: never, call: never, getBlock: never, getCode: never } as any
+  const accountState = {
+    accountAddr: OWN,
+    nonce: 0n,
+    eoaNonce: 0n,
+    isEOA: true,
+    isSmarterEoa: false,
+    isV2: false,
+    delegatedContract: null
+  }
+  const account = { addr: OWN, associatedKeys: [OWN], initialPrivileges: [], creation: null }
+  return new SignAccountOpController(
+    {
+      accounts: [account],
+      accountStates: { [OWN]: { [sepolia.chainId.toString()]: accountState } },
+      getOrFetchAccountOnChainState: never
+    } as any,
+    { networks: [sepolia] } as any,
+    keystore as any,
+    {
+      addTokensToBeLearned: () => {},
+      simulateAccountOp: never,
+      getLatestPortfolioState: () => ({}),
+      getPendingPortfolioState: () => ({})
+    } as any,
+    {} as any,
+    {},
+    account as any,
+    sepolia,
+    provider,
+    1,
+    {
+      accountAddr: OWN,
+      chainId: sepolia.chainId,
+      signingKeyAddr: OWN,
+      signingKeyType: 'internal',
+      nonce: 0n,
+      calls,
+      gasLimit: null,
+      signature: null,
+      gasFeePayment: null,
+      accountOpToExecuteBefore: null
+    },
+    () => false,
+    false,
+    undefined,
+    tocsin
+  )
+}
+
+const approve = (spender: string) =>
+  encodeFunctionData({
+    abi: parseAbi(['function approve(address spender, uint256 amount)']),
+    args: [spender as `0x${string}`, 1n]
+  })
+
+describe('SignAccountOpController with tocsin', () => {
+  test('a block on a decoded approve spender disables signing; sign() never asks for a signer', async () => {
+    const tocsin = await syncedTocsin()
+    const keystore = recordingKeystore()
+    const ctrl = signAccountOpWith(tocsin, keystore, [
+      { to: CLEAN, value: 0n, data: approve(SPENDER) }
+    ])
+
+    expect(ctrl.tocsinTargets.map((t) => [t.address, t.context])).toEqual([
+      [CLEAN, 'recipient'],
+      [SPENDER, 'spender']
+    ])
+    await until(() => ctrl.tocsin?.verdict === 'block')
+    // Everything else ready: only tocsin holds it back.
+    ctrl.updateStatus(SigningStatus.ReadyToSign)
+    expect(ctrl.readyToSign).toBe(false)
+    expect(ctrl.toJSON().tocsin?.verdict).toBe('block')
+
+    await ctrl.sign()
+    expect(keystore.signerRequests).toEqual([])
+    expect(ctrl.status?.type).toBe(SigningStatus.ReadyToSign)
+    expect(ctrl.emittedErrors.map((e) => e.message)).toContain(BLOCKED_SEND_LINE)
+    ctrl.reset()
+  })
+
+  test('with no flag the same op is ready to sign', async () => {
+    const tocsin = await syncedTocsin()
+    const keystore = recordingKeystore()
+    const ctrl = signAccountOpWith(tocsin, keystore, [
+      { to: CLEAN, value: 0n, data: approve(CLEAN) }
+    ])
+
+    await until(() => ctrl.tocsin?.verdict === 'clean')
+    ctrl.updateStatus(SigningStatus.ReadyToSign)
+    expect(ctrl.readyToSign).toBe(true)
+    ctrl.reset()
+  })
+})
