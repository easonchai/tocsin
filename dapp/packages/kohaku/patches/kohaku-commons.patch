+// Settings input validation, copied from the antibody Snap (dapp/packages/snap/src/settings.ts).
+import { normalize } from 'viem/ens'
+
+/** An https URL, or http for localhost (the lying proxy). */
+export function parseRpcUrl(raw: unknown): { url: string } | { error: string } {
+  try {
+    const u = new URL(typeof raw === 'string' ? raw.trim() : '')
+    const local = u.hostname === '127.0.0.1' || u.hostname === 'localhost'
+    if (u.protocol === 'https:' || (u.protocol === 'http:' && local)) return { url: u.href }
+  } catch {
+    // fall through
+  }
+  return { error: 'Enter an https URL (http only for localhost).' }
+}
+
+/** A normalised ENS name with at least one dot. */
+export function parseListName(raw: unknown): { name: string } | { error: string } {
+  const s = typeof raw === 'string' ? raw.trim() : ''
+  try {
+    const name = normalize(s)
+    if (name.includes('.')) return { name }
+  } catch {
+    // fall through
+  }
+  return { error: `"${s}" is not an ENS name such as name.tocsin.eth.` }
+}
diff --git a/src/libs/tocsin/state.ts b/src/libs/tocsin/state.ts
new file mode 100644
index 000000000..1f586e552
--- /dev/null
+++ b/src/libs/tocsin/state.ts
@@ -0,0 +1,100 @@
+// Tocsin state: the RPC, the lists, checkpoints, and the last sync. Ported from the antibody Snap
+// (dapp/packages/snap/src/state.ts). Ambire storage serialises through richJson, which keeps
+// bigints, so the Snap's own JSON codec is gone. Nothing about an evaluated address is ever stored
+// (snap-ui spec, section 7).
+import type { Address, Hex } from 'viem'
+
+import type { SignedList, SyncResult, WriterCheckpoint } from './reader'
+
+export type Settings = {
+  /** Header, proofs, ENS and leaves all come from this one RPC. */
+  rpcUrl: string
+}
+
+export type SyncStatus = {
+  at: number
+  /** Why the last sync could not run (no list, RPC down). */
+  error?: string
+}
+
+/** One list name. Kept while unfollowed, so following it again keeps the first-use pin. */
+export type ListState = {
+  followed: boolean
+  pinned?: SignedList
+  /** A list signed by a new maintainer. The list is excluded until the user accepts it. */
+  pending?: SignedList
+  /** acceptList's status at the last sync, plus the reject reason. */
+  status?: string
+}
+
+/** The last sync where every writer synced. Shown when the current one is unverifiable. */
+export type LastGood = { flags: number; writers: number; block: bigint; at: number }
+
+export type State = {
+  settings: Settings
+  lists: Record<string, ListState>
+  checkpoints: Record<string, WriterCheckpoint>
+  /** Writer errors are kept as their message (engine.ts `plainErrors`), so the state stores as JSON. */
+  sync?: SyncResult
+  /** When `sync` was taken. */
+  syncedAt?: number
+  lastGood?: LastGood
+  /** Forward-checked ENS names of writers. */
+  names: Record<Address, string>
+  status?: SyncStatus
+}
+
+/** The Ambire storage key. */
+export const STORAGE_KEY = 'tocsin'
+
+export const LOG: Address = '0xB639d15A0E7aE24E4C32E851Fbe0E57585565b14'
+export const LOG_CHAIN_ID = 11155111n
+/** The log's deployment block, where eth_getLogs scans start. Build-time only (.env via babel). */
+export const FROM_BLOCK = BigInt(process.env.TOCSIN_LOG_FROM_BLOCK || '0')
+
+const csv = (s: string | undefined) =>
+  (s ?? '')
+    .split(',')
+    .map((x) => x.trim())
+    .filter(Boolean)
+const DEFAULT_LISTS = csv(process.env.TOCSIN_LIST_NAME)
+
+export const DEFAULT_SETTINGS: Settings = {
+  // 0xrpc.io passes proofs at "latest"; publicnode fails about 1 in 6 (antibody runbook.md:144).
+  rpcUrl: process.env.TOCSIN_RPC_URL || 'https://0xrpc.io/sep'
+}
+
+/**
+ * Record hex per name that replaces the ENS lookup, for a rehearsal before the name exists:
+ * `TOCSIN_LIST_RECORD` for the first default name.
+ */
+export const RECORD_OVERRIDES: Record<string, Hex> = Object.fromEntries(
+  DEFAULT_LISTS[0] && process.env.TOCSIN_LIST_RECORD
+    ? [[DEFAULT_LISTS[0], process.env.TOCSIN_LIST_RECORD as Hex]]
+    : []
+)
+
+export const freshState = (): State => ({
+  settings: DEFAULT_SETTINGS,
+  lists: Object.fromEntries(DEFAULT_LISTS.map((n) => [n, { followed: true }])),
+  checkpoints: {},
+  names: {}
+})
+
+/** The stored state merged over defaults. Only the TocsinController writes it. */
+export function fromStored(stored: Partial<State> | null | undefined): State {
+  const fresh = freshState()
+  if (!stored) return fresh
+  const lists = Object.fromEntries(
+    Object.entries(stored.lists ?? fresh.lists).map(([n, l]) => [
+      n,
+      { ...l, followed: l.followed ?? true }
+    ])
+  )
+  return {
+    ...fresh,
+    ...stored,
+    settings: { ...DEFAULT_SETTINGS, rpcUrl: stored.settings?.rpcUrl ?? DEFAULT_SETTINGS.rpcUrl },
+    lists
+  }
+}
diff --git a/test/helpers/tocsin.ts b/test/helpers/tocsin.ts
new file mode 100644
index 000000000..302e1bf98
--- /dev/null
+++ b/test/helpers/tocsin.ts
@@ -0,0 +1,236 @@
+// A fake Sepolia JSON-RPC, a lying RPC, the list host and ENS, ported from the antibody Snap's
+// bundle test (dapp/packages/snap/test/bundle.test.ts). Fixtures are built with the reader's own
+// chain and list helpers so the hashes cannot drift.
+import {
+  type Address,
+  decodeFunctionData,
+  encodeAbiParameters,
+  encodeEventTopics,
+  encodeFunctionResult,
+  getAddress,
+  type Hex,
+  hexToBigInt,
+  numberToHex,
+  pad,
+  parseAbi,
+  toFunctionSelector,
+  zeroHash
+} from 'viem'
+import { privateKeyToAccount } from 'viem/accounts'
+
+import {
+  encodeListRecord,
+  foldHead,
+  leafHash,
+  listRoot,
+  listRootTypedData,
+  threatFlagLogAbi,
+  writerHeadSlot,
+  writerSeqSlot
+} from '../../src/libs/tocsin/reader'
+
+export const LOG = getAddress('0xB639d15A0E7aE24E4C32E851Fbe0E57585565b14')
+const UR = getAddress('0xeEeEEEeE14D718C2B47D9923Deab1335E144EeEe')
+export const MANUAL = getAddress('0x00000000000000000000000000000000000a11ce')
+export const DETECTOR = getAddress('0x00000000000000000000000000000000000de7ec')
+export const DRAINER = getAddress('0xd7a1000000000000000000000000000000000bad')
+export const SPENDER = getAddress('0x5bead00000000000000000000000000000000bad')
+export const CLEAN = getAddress('0xc1ea000000000000000000000000000000000001')
+export const SUSPECT = getAddress('0x5005000000000000000000000000000000000bad')
+const EVIDENCE: Hex = `0x${'ee'.repeat(32)}`
+
+// --- the log: two FLAG leaves from the manual writer (weight 255), one from the detector (weight 1)
+type Raw = { blockNumber: bigint; topics: Hex[]; data: Hex; writer: Address; writerSeq: bigint }
+const appended = threatFlagLogAbi.find((x) => x.type === 'event' && x.name === 'Appended')!
+const dataParams = (appended as { inputs: readonly { indexed?: boolean }[] }).inputs.filter(
+  (i) => !('indexed' in i)
+)
+const logs: Raw[] = []
+const heads: Record<Address, { head: Hex; seq: bigint }> = {
+  [MANUAL]: { head: zeroHash, seq: 0n },
+  [DETECTOR]: { head: zeroHash, seq: 0n }
+}
+const flags: [Address, Address, number][] = [
+  [MANUAL, DRAINER, 3],
+  [MANUAL, SPENDER, 7],
+  [DETECTOR, SUSPECT, 3]
+]
+flags.forEach(([writer, subject, category], i) => {
+  const h = heads[writer]!
+  const writerSeq = h.seq + 1n
+  const globalSeq = BigInt(i + 1)
+  const blockNumber = 101n + BigInt(i)
+  const leaf = {
+    chainId: 11155111n,
+    subject,
+    category,
+    op: 0,
+    evidence: EVIDENCE,
+    seenBlock: 100n,
+    refLeaf: zeroHash
+  }
+  const lh = leafHash({ writer, blockNumber, writerSeq, globalSeq, leaf })
+  heads[writer] = { head: foldHead(h.head, lh), seq: writerSeq }
+  logs.push({
+    blockNumber,
+    writer,
+    writerSeq,
+    topics: encodeEventTopics({
+      abi: threatFlagLogAbi,
+      eventName: 'Appended',
+      args: { writer, writerSeq }
+    }) as Hex[],
+    data: encodeAbiParameters(
+      dataParams as never,
+      [globalSeq, lh, heads[writer]!.head, heads[writer]!.head, leaf] as never
+    )
+  })
+})
+const slotValue = new Map<string, Hex>()
+Object.entries(heads).forEach(([w, v]) => {
+  slotValue.set(writerHeadSlot(w as Address), v.head)
+  slotValue.set(writerSeqSlot(w as Address), numberToHex(v.seq))
+})
+
+// --- lists ------------------------------------------------------------------------------------
+const entry = (writer: Address, weight: number) => ({
+  writer,
+  weight,
+  operator: zeroHash,
+  upstream: zeroHash,
+  fromBlock: 0n,
+  toBlock: 0n,
+  headPin: zeroHash,
+  categories: 1n, // bit 0: trust categories 1 to 127
+  snapshotURI: `https://mirror.test/${writer}.json`
+})
+export async function signedList(
+  key: Hex,
+  version: bigint,
+  entries = [entry(MANUAL, 255), entry(DETECTOR, 1)],
+  listURI = 'https://lists.test/default.json'
+) {
+  const maintainer = privateKeyToAccount(key)
+  const list = { log: LOG, chainId: 11155111n, maintainer: maintainer.address, version, entries }
+  const root = listRoot(list)
+  const signature = await maintainer.signTypedData(listRootTypedData(list, root))
+  const document = JSON.parse(
+    JSON.stringify(list, (_k, v) => (typeof v === 'bigint' ? v.toString() : v))
+  )
+  return {
+    record: encodeListRecord({ root, version, signature, listURI }),
+    document,
+    listURI,
+    maintainer: maintainer.address
+  }
+}
+export type Signed = Awaited<ReturnType<typeof signedList>>
+
+// --- fake network -----------------------------------------------------------------------------
+const urAbi = parseAbi([
+  'function resolveWithGateways(bytes name, bytes data, string[] gateways) view returns (bytes result, address resolver)',
+  'function reverseWithGateways(bytes lookupAddress, uint256 coinType, string[] gateways) view returns (string name, address resolver, address reverseResolver)'
+])
+const resolverAbi = parseAbi([
+  'function text(bytes32 node, string key) view returns (string)',
+  'function addr(bytes32 node) view returns (address)'
+])
+const RESOLVER = getAddress('0x0000000000000000000000000000000000000e45')
+
+/** `lists` by ENS name. `requests` records every host the code reached. */
+export type World = { lists: Record<string, Signed>; requests: string[]; chainId: Hex }
+export const world: World = { lists: {}, requests: [], chainId: '0xaa36a7' }
+
+/** DNS wire format, as the Universal Resolver takes names. */
+function dnsName(h: Hex): string {
+  const b = Buffer.from(h.slice(2), 'hex')
+  const labels: string[] = []
+  for (let i = 0; b[i]; i += b[i]! + 1) labels.push(b.subarray(i + 1, i + 1 + b[i]!).toString())
+  return labels.join('.')
+}
+const reverted = () => Object.assign(new Error('execution reverted'), { rpc: true })
+
+function rpc(method: string, params: any[], lying: boolean): unknown {
+  if (method === 'eth_chainId') return world.chainId
+  if (method === 'eth_blockNumber') return '0x200'
+  if (method === 'eth_getBlockByNumber')
+    return {
+      number: params[0] === 'finalized' ? '0x1f0' : '0x200',
+      hash: pad('0x200', { size: 32 }),
+      stateRoot: pad('0x5', { size: 32 })
+    }
+  if (method === 'eth_getProof')
+    return {
+      storageProof: (params[1] as Hex[]).map((key) => ({
+        key,
+        value: slotValue.get(key) ?? '0x0',
+        proof: []
+      }))
+    }
+  if (method === 'eth_getLogs') {
+    const [{ topics, fromBlock, toBlock }] = params
+    return (
+      logs
+        // the lying RPC drops the manual writer's first leaf
+        .filter((l) => !(lying && l.writer === MANUAL && l.writerSeq === 1n))
+        .filter((l) => l.topics[1] === topics[1] && (!topics[2] || l.topics[2] === topics[2]))
+        .filter(
+          (l) => l.blockNumber >= hexToBigInt(fromBlock) && l.blockNumber <= hexToBigInt(toBlock)
+        )
+        .map((l) => ({
+          blockNumber: numberToHex(l.blockNumber),
+          topics: l.topics,
+          data: l.data,
+          removed: false
+        }))
+    )
+  }
+  if (method === 'eth_call') {
+    const { to, data } = params[0] as { to: Address; data: Hex }
+    if (getAddress(to) !== UR) throw new Error('every ENS read goes to the Universal Resolver')
+    if (data.startsWith(toFunctionSelector(urAbi[1]))) {
+      const [lookup] = decodeFunctionData({ abi: urAbi, data }).args as [Hex, bigint, string[]]
+      if (getAddress(lookup) !== MANUAL) throw reverted()
+      return encodeFunctionResult({
+        abi: urAbi,
+        functionName: 'reverseWithGateways',
+        result: ['manual.tocsin.eth', RESOLVER, RESOLVER]
+      })
+    }
+    const [name, inner] = decodeFunctionData({ abi: urAbi, data }).args as [Hex, Hex, string[]]
+    const call = decodeFunctionData({ abi: resolverAbi, data: inner })
+    const named = world.lists[dnsName(name)]
+    if (call.functionName === 'text' && !named) throw reverted() // no such name
+    const result =
+      call.functionName === 'text'
+        ? encodeFunctionResult({ abi: resolverAbi, functionName: 'text', result: named!.record })
+        : encodeFunctionResult({ abi: resolverAbi, functionName: 'addr', result: MANUAL })
+    return encodeFunctionResult({
+      abi: urAbi,
+      functionName: 'resolveWithGateways',
+      result: [result, RESOLVER]
+    })
+  }
+  throw new Error(`unexpected ${method}`)
+}
+
+const json = (body: unknown) =>
+  new Response(JSON.stringify(body), { headers: { 'content-type': 'application/json' } })
+
+/** `https://rpc.test` is honest, `https://liar.test` drops one leaf, `https://lists.test` serves list documents. */
+export async function fakeFetch(input: RequestInfo | URL, init?: RequestInit): Promise<Response> {
+  const url = new URL(String(input))
+  world.requests.push(url.host)
