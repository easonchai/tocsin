+    } catch (e) {
+      if (!(e as { rpc?: boolean }).rpc) throw e
+      return json({ jsonrpc: '2.0', id, error: { code: 3, message: 'execution reverted' } })
+    }
+  }
+  if (url.host === 'lists.test')
+    return json(Object.values(world.lists).find((l) => l.listURI === url.href)!.document)
