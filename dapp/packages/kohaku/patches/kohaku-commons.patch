diff --git a/src/libs/tocsin/check.ts b/src/libs/tocsin/check.ts
new file mode 100644
index 000000000..bda286113
--- /dev/null
+++ b/src/libs/tocsin/check.ts
@@ -0,0 +1,39 @@
+// The combined verdict for the addresses one signing request touches, read from the
+// TocsinController's cache. The signing controllers use it to decide and to block.
+import type { Target } from './decode'
+import { assessmentKey, isChecking, type TocsinAssessment, type TocsinView, worst } from './display'
+import type { Verdict } from './reader'
+
+export type TocsinCheck = {
+  chainId: bigint
+  /** The worst verdict over every target; `checking` until each target has an assessment. */
+  verdict: Verdict | 'checking'
+  /** One per target that has finished, in target order. */
+  assessments: TocsinAssessment[]
+}
+
+/** The TocsinController itself, or its serialised state on the UI side. */
+type Cache = TocsinView & { assessments: Record<string, TocsinAssessment> }
+
+export const BLOCKED_SEND_LINE =
+  'Sending is blocked. Tocsin flagged an address in this transaction.'
+export const BLOCKED_SIGN_LINE = 'Signing is blocked. Tocsin flagged an address in this signature.'
+
+/** One target per address and context, so an address used twice in a batch is listed once. */
+export const uniqueTargets = (targets: readonly Target[]): Target[] =>
+  targets.filter(
+    (t, i) => targets.findIndex((u) => assessmentKey(u, 0n) === assessmentKey(t, 0n)) === i
+  )
+
+export function tocsinCheck(
+  cache: Cache,
+  targets: readonly Target[],
+  chainId: bigint
+): TocsinCheck {
+  if (isChecking(cache)) return { chainId, verdict: 'checking', assessments: [] }
+  const assessments = targets
+    .map((t) => cache.assessments[assessmentKey(t, chainId)])
+    .filter((a): a is TocsinAssessment => a !== undefined)
+  const verdict = assessments.length < targets.length ? 'checking' : worst(assessments)
+  return { chainId, verdict, assessments }
+}
diff --git a/src/libs/tocsin/decode.test.ts b/src/libs/tocsin/decode.test.ts
