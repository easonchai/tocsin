+
+// The Snap's line points at Kohaku for full verification. This build is that Kohaku: Anon-RPC yes, light client not yet.
+const NETWORK_LINE =
+  TRANSPORT === 'direct'
+    ? 'This build reads the header and proofs from the RPC you pick, best effort. It is not a light client and does not use Anon-RPC. The RPC can see which flags you download, never which address you check.'
+    : `This build reads the header and proofs from the RPC you pick through the ${TRANSPORT} Anon-RPC worker, best effort. It is not a light client. The RPC sees which flags are downloaded, never who asked or which address you check. Localhost RPCs go direct.`
+
