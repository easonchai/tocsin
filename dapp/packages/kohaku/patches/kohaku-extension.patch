diff --git a/src/web/contexts/tocsinControllerStateContext/tocsinControllerStateContext.tsx b/src/web/contexts/tocsinControllerStateContext/tocsinControllerStateContext.tsx
new file mode 100644
index 000000000..006506cf7
--- /dev/null
+++ b/src/web/contexts/tocsinControllerStateContext/tocsinControllerStateContext.tsx
@@ -0,0 +1,31 @@
+import React, { createContext, useEffect } from 'react'
+
+import { TocsinController } from '@ambire-common/controllers/tocsin/tocsin'
+import useDeepMemo from '@common/hooks/useDeepMemo'
+import useBackgroundService from '@web/hooks/useBackgroundService'
+import useControllerState from '@web/hooks/useControllerState'
+import useMainControllerState from '@web/hooks/useMainControllerState'
+
+const TocsinControllerStateContext = createContext<TocsinController>({} as TocsinController)
+
+const TocsinControllerStateProvider: React.FC<any> = ({ children }) => {
+  const controller = 'tocsin'
+  const state = useControllerState(controller)
+  const { dispatch } = useBackgroundService()
+  const mainState = useMainControllerState()
+
+  useEffect(() => {
+    if (!Object.keys(state).length)
+      dispatch({ type: 'INIT_CONTROLLER_STATE', params: { controller } })
+  }, [dispatch, mainState.isReady, state])
+
+  const memoizedState = useDeepMemo(state, controller)
+
+  return (
+    <TocsinControllerStateContext.Provider value={memoizedState}>
+      {children}
+    </TocsinControllerStateContext.Provider>
+  )
+}
+
+export { TocsinControllerStateProvider, TocsinControllerStateContext }
