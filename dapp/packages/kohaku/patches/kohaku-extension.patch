@@ -0,0 +1,387 @@
+// Tocsin settings: the Snap's home page (snap-ui.md section 5, dapp/packages/snap/src/ui.tsx HomePage)
+// in Kohaku's settings components. Every control dispatches a TOCSIN_CONTROLLER_* action; the results
+// come back through useTocsinControllerState().
+import React, { useContext, useEffect, useState } from 'react'
+import { View } from 'react-native'
+
+import {
+  ABOUT_LINE,
+  ago,
+  host,
+  type ListSummary,
+  type ListView,
+  num,
+  plural,
+  POLICY_LINES,
+  proven,
+  short,
+  SOURCE_URL,
+  STANDARD_URL,
+  whyUnavailable,
+  writerLabel
+} from '@ambire-common/libs/tocsin/display'
+import Alert from '@common/components/Alert'
+import Button from '@common/components/Button'
+import FatToggle from '@common/components/FatToggle'
+import Input from '@common/components/Input'
+import Spinner from '@common/components/Spinner'
+import Text, { TextAppearance } from '@common/components/Text'
+import useTheme from '@common/hooks/useTheme'
+import spacings from '@common/styles/spacings'
+import common from '@common/styles/utils/common'
+import flexbox from '@common/styles/utils/flexbox'
+import { openInTab } from '@web/extension-services/background/webapi/tab'
+import useBackgroundService from '@web/hooks/useBackgroundService'
+import useTocsinControllerState from '@web/hooks/useTocsinControllerState'
+import SettingsPageHeader from '@web/modules/settings/components/SettingsPageHeader'
+import { SettingsRoutesContext } from '@web/modules/settings/contexts/SettingsRoutesContext'
+
+// The Snap's line points at Kohaku for full verification. This build is that Kohaku, and it does not.
+const NETWORK_LINE =
+  'This build reads the header and proofs from the RPC you pick, best effort. It is not a light client and does not use Anon-RPC. The RPC can see which flags you download, never which address you check.'
+
+const Row = ({
+  label,
+  value,
+  appearance
+}: {
+  label: string
+  value: string
+  appearance?: TextAppearance
+}) => (
+  <View style={[flexbox.directionRow, flexbox.justifySpaceBetween, spacings.mbTy]}>
+    <Text fontSize={14} appearance="secondaryText" style={spacings.mr}>
+      {label}
+    </Text>
+    <Text fontSize={14} appearance={appearance} style={[flexbox.flex1, { textAlign: 'right' }]}>
+      {value}
+    </Text>
+  </View>
+)
+
+const Card = ({ children, style }: { children: React.ReactNode; style?: any }) => {
+  const { theme } = useTheme()
+  return (
+    <View
+      style={[
+        spacings.pv,
+        spacings.ph,
+        common.borderRadiusPrimary,
+        { backgroundColor: theme.secondaryBackground },
+        style
+      ]}
+    >
+      {children}
+    </View>
+  )
+}
+
+const describe = (l: ListSummary | undefined) =>
+  l
+    ? `maintainer ${short(l.maintainer)} · ${plural(l.writers.length, 'writer')} · version ${num(
+        l.version
+      )}`
+    : 'not pinned yet'
+
+const ListCard = ({ list }: { list: ListView }) => {
+  const { dispatch } = useBackgroundService()
+  const [isReviewing, setIsReviewing] = useState(false)
+  const { name, followed, status, pinned, pending } = list
+
+  return (
+    <Card style={spacings.mbSm}>
+      <Text fontSize={16} weight="medium">
+        {name}
+      </Text>
+      <Text fontSize={14} appearance="secondaryText" style={spacings.mbSm}>
+        {describe(pinned)}
+      </Text>
+      {pending && !isReviewing ? (
+        <Alert
+          type="warning"
+          size="sm"
+          title="Maintainer changed"
+          text={`Was ${pinned ? short(pinned.maintainer) : 'unknown'}, now ${short(
+            pending.maintainer
+          )}. Excluded until you review.`}
+          buttonProps={{ text: 'Review', onPress: () => setIsReviewing(true) }}
+          style={spacings.mbSm}
+        />
+      ) : null}
+      {pending && isReviewing ? (
+        <Alert type="warning" size="sm" title="List maintainer changed" style={spacings.mbSm}>
+          <Text fontSize={14} style={spacings.mvTy}>
+            {`The list at ${name} is now signed by a different maintainer. It stays excluded unless you accept.`}
+          </Text>
+          {pinned ? <Row label="Pinned maintainer" value={pinned.maintainer} /> : null}
+          {pinned ? <Row label="Pinned version" value={num(pinned.version)} /> : null}
+          <Row label="New maintainer" value={pending.maintainer} appearance="warningText" />
+          <Row label="New version" value={num(pending.version)} />
+          <Text fontSize={14} style={spacings.mbSm}>
+            Accept only if you know why the maintainer changed. A stolen name can point at a list
+            signed by anyone.
+          </Text>
+          <View style={[flexbox.directionRow, flexbox.justifyEnd]}>
+            <Button
+              text="Cancel"
+              type="secondary"
+              size="small"
+              hasBottomSpacing={false}
+              style={spacings.mrTy}
+              onPress={() => setIsReviewing(false)}
+            />
+            <Button
+              text="Accept"
+              type="warning"
+              size="small"
+              hasBottomSpacing={false}
+              onPress={() => {
+                dispatch({ type: 'TOCSIN_CONTROLLER_ACCEPT_MAINTAINER_CHANGE', params: { name } })
+                setIsReviewing(false)
+              }}
+            />
+          </View>
+        </Alert>
+      ) : null}
+      {status && status !== 'accepted' && !pending ? (
+        <Text fontSize={14} appearance="warningText" style={spacings.mbSm}>
+          {`Last check: ${status}`}
+        </Text>
+      ) : null}
+      <View style={[flexbox.directionRow, flexbox.alignCenter, flexbox.justifySpaceBetween]}>
+        <FatToggle
+          id={`tocsin-follow-${name}`}
+          label="Follow this list"
+          labelProps={{ style: [spacings.mlTy, { fontSize: 14 }] }}
+          isOn={followed}
+          onToggle={() =>
+            dispatch({
+              type: 'TOCSIN_CONTROLLER_SET_FOLLOWED',
+              params: { name, followed: !followed }
+            })
+          }
+        />
+        <Button
+          text="Remove"
+          type="danger"
+          size="small"
+          hasBottomSpacing={false}
+          onPress={() => dispatch({ type: 'TOCSIN_CONTROLLER_REMOVE_LIST', params: { name } })}
+        />
+      </View>
+    </Card>
+  )
+}
+
+const TocsinSettingsScreen = () => {
+  const { setCurrentSettingsPage } = useContext(SettingsRoutesContext)
+  const { dispatch } = useBackgroundService()
+  const state = useTocsinControllerState()
+  const {
+    settings,
+    lists,
+    sync,
+    syncedAt,
+    status,
+    isSyncing,
+    addListCandidate,
+    isFetchingCandidate,
+    formErrors
+  } = state
+  const [listName, setListName] = useState('')
+  const [rpcUrl, setRpcUrl] = useState(settings?.rpcUrl ?? '')
+
+  useEffect(() => {
+    setCurrentSettingsPage('tocsin')
+  }, [setCurrentSettingsPage])
+
+  useEffect(() => {
+    if (settings?.rpcUrl) setRpcUrl(settings.rpcUrl)
+  }, [settings?.rpcUrl])
+
+  // The context is empty until the background sends the first state.
+  if (!settings || !lists) return <Spinner style={{ alignSelf: 'center' }} />
+
+  const failing = Object.values(sync?.writers ?? {}).filter((w) => w.status !== 'synced')
+  const addList = () => {
+    if (listName.trim())
+      dispatch({ type: 'TOCSIN_CONTROLLER_ADD_LIST', params: { name: listName } })
+  }
+  const saveRpc = () => dispatch({ type: 'TOCSIN_CONTROLLER_UPDATE_SETTINGS', params: { rpcUrl } })
+
+  return (
+    <>
+      <SettingsPageHeader title="Tocsin">
+        <View style={[flexbox.directionRow, flexbox.alignCenter]}>
+          {isSyncing ? (
+            <>
+              <Spinner style={{ width: 24, height: 24 }} />
+              <Text fontSize={14} appearance="secondaryText" style={spacings.mrSm}>
+                Syncing…
+              </Text>
+            </>
+          ) : null}
+          <Button
+            text="Sync now"
+            size="small"
+            hasBottomSpacing={false}
+            disabled={isSyncing}
+            onPress={() => dispatch({ type: 'TOCSIN_CONTROLLER_SYNC' })}
+          />
+        </View>
+      </SettingsPageHeader>
+
+      <Card style={spacings.mbLg}>
+        <Row
+          label="flags"
+          value={
+            sync
+              ? `${num(sync.flags)} across ${plural(Object.keys(sync.writers).length, 'writer')}`
+              : 'none yet'
+          }
+        />
+        <Row label="proven head" value={proven(state)} />
+        <Row label="last sync" value={syncedAt ? ago(syncedAt) : 'never'} />
+        <Row label="source" value={`${host(settings.rpcUrl)} · best effort, not a light client`} />
+        {failing.map((w) => (
+          <Row
+            key={w.writer}
+            label={writerLabel(state, w.writer)}
+            value={whyUnavailable(w)}
+            appearance="warningText"
+          />
+        ))}
+      </Card>
+      {status?.error ? (
+        <Alert type="warning" title="Last sync failed" text={status.error} style={spacings.mbLg} />
+      ) : null}
+
+      <SettingsPageHeader title="Lists" />
+      {lists.length === 0 ? (
+        <Text fontSize={14} style={spacings.mbSm}>
+          No lists yet. Add one below.
+        </Text>
+      ) : null}
+      {lists.map((l) => (
+        <ListCard key={l.name} list={l} />
+      ))}
+      <View style={[flexbox.directionRow, flexbox.alignStart, spacings.mtSm]}>
+        <Input
+          label="Add a list by ENS name"
+          placeholder="name.tocsin.eth"
+          value={listName}
+          onChangeText={setListName}
+          onSubmitEditing={addList}
+          error={formErrors?.listName}
+          containerStyle={[flexbox.flex1, spacings.mrSm]}
+          autoCapitalize="none"
+        />
+        <Button
+          text={isFetchingCandidate ? 'Checking…' : 'Add'}
+          hasBottomSpacing={false}
+          style={{ marginTop: 24 }}
+          disabled={isFetchingCandidate || !!addListCandidate || !listName.trim()}
+          onPress={addList}
+        />
+      </View>
+      {addListCandidate ? (
+        <Card style={spacings.mbLg}>
+          <Text fontSize={16} weight="medium" style={spacings.mbSm}>
+            {`Pin ${addListCandidate.name}?`}
+          </Text>
+          <Row label="maintainer" value={addListCandidate.maintainer} />
+          <Row label="writers" value={num(addListCandidate.writers.length)} />
+          <Row label="version" value={num(addListCandidate.version)} />
+          <Text fontSize={14} style={spacings.mbSm}>
+            Tocsin pins this maintainer. A list signed by anyone else is held for your review and
+            not used until you accept it.
+          </Text>
+          <View style={[flexbox.directionRow, flexbox.justifyEnd]}>
+            <Button
+              text="Cancel"
+              type="secondary"
+              size="small"
+              hasBottomSpacing={false}
+              style={spacings.mrTy}
+              onPress={() => dispatch({ type: 'TOCSIN_CONTROLLER_CANCEL_ADD_LIST' })}
+            />
+            <Button
+              text="Confirm"
+              size="small"
+              hasBottomSpacing={false}
+              onPress={() => {
+                dispatch({ type: 'TOCSIN_CONTROLLER_CONFIRM_ADD_LIST' })
+                setListName('')
+              }}
+            />
+          </View>
+        </Card>
+      ) : null}
+
+      <View style={spacings.mtLg}>
+        <SettingsPageHeader title="Policy" />
+      </View>
+      {POLICY_LINES.map((line) => (
+        <Text key={line} fontSize={14} style={spacings.mbSm}>
+          {line}
+        </Text>
+      ))}
+
+      <View style={spacings.mtLg}>
+        <SettingsPageHeader title="Network" />
+      </View>
+      <View style={[flexbox.directionRow, flexbox.alignStart]}>
+        <Input
+          label="RPC URL"
+          value={rpcUrl}
+          onChangeText={setRpcUrl}
+          onSubmitEditing={saveRpc}
+          error={formErrors?.rpcUrl}
+          containerStyle={[flexbox.flex1, spacings.mrSm]}
+          autoCapitalize="none"
+        />
+        <Button
+          text="Save and sync"
+          hasBottomSpacing={false}
+          style={{ marginTop: 24 }}
+          disabled={isSyncing || !rpcUrl.trim()}
+          onPress={saveRpc}
+        />
+      </View>
+      <Text fontSize={14} appearance="secondaryText" style={spacings.mbLg}>
+        {NETWORK_LINE}
+      </Text>
+
+      <SettingsPageHeader title="About" />
+      <Text fontSize={14} style={spacings.mbSm}>
+        {ABOUT_LINE}
+      </Text>
+      <View style={[flexbox.directionRow, spacings.mbSm]}>
+        <Text
+          fontSize={14}
+          appearance="primary"
+          underline
+          accessibilityRole="link"
+          style={spacings.mrLg}
+          onPress={() => openInTab({ url: STANDARD_URL })}
+        >
+          Read the standard
+        </Text>
+        <Text
+          fontSize={14}
+          appearance="primary"
+          underline
+          accessibilityRole="link"
+          onPress={() => openInTab({ url: SOURCE_URL })}
+        >
+          Source
+        </Text>
+      </View>
+      <Text fontSize={12} appearance="secondaryText">
+        Flag log on Sepolia
+      </Text>
+    </>
+  )
+}
+
+export default React.memo(TocsinSettingsScreen)
