diff --git a/src/web/extension-services/tocsin-offscreen/offscreen.ts b/src/web/extension-services/tocsin-offscreen/offscreen.ts
new file mode 100644
index 000000000..0ee0fbff6
--- /dev/null
+++ b/src/web/extension-services/tocsin-offscreen/offscreen.ts
@@ -0,0 +1,81 @@
+// The offscreen document that owns Tocsin's Anon-RPC worker. It lives here, not in the service
+// worker, because the harness needs a DOM (a sandboxed iframe that spawns a Worker) and service
+// workers have neither. The service worker relays Tocsin's fetches here over a named port
+// (tocsinAnonRpc.ts) and gets serialised responses back. Nothing is persisted here.
+import type { AnonRpcWorker } from '@anon-rpc/browser-harness'
+
+import { bootstrapAnonRpc, startHelios, type Transport } from './harness/anonHelios'
+import { type OffscreenReply, type OffscreenRequest, PORT_NAME } from './protocol'
+
+const TRANSPORT = (process.env.TOCSIN_TRANSPORT || 'tor') as Transport
+const GATEWAYS = (process.env.TOCSIN_TOR_GATEWAYS || '')
+  .split(',')
+  .map((s) => s.trim())
+  .filter(Boolean)
+const MAINNET = {
+  consensusRpc: process.env.TOCSIN_MAINNET_CONSENSUS_RPC || '',
+  executionRpc: process.env.TOCSIN_MAINNET_EXECUTION_RPC || ''
+}
+
+let stage = 'starting'
+let ready = false
+const errorText = (e: unknown): string =>
+  e instanceof Error
+    ? e.cause instanceof Error
+      ? `${e.message}: ${e.cause.message}`
+      : e.message
+    : String(e)
+
+async function boot(): Promise<AnonRpcWorker> {
+  if (!MAINNET.consensusRpc || !MAINNET.executionRpc)
+    throw new Error('built without TOCSIN_MAINNET_CONSENSUS_RPC and TOCSIN_MAINNET_EXECUTION_RPC')
+  stage = 'syncing the mainnet light client that verifies the Anon-RPC worker'
+  const mainnet = await startHelios('mainnet', MAINNET)
+  stage = `booting the ${TRANSPORT} Anon-RPC worker`
+  try {
+    const { worker } = await bootstrapAnonRpc({
+      transport: TRANSPORT,
+      mainnetHelios: mainnet,
+      torGateways: GATEWAYS,
+      // The harness builds its iframe from an inline srcdoc by default, which the extension CSP blocks;
+      // anon-boot.html is a manifest sandbox page that loads the same boot script.
+      iframeUrl: chrome.runtime.getURL('anon-boot.html')
+    })
+    stage = 'ready'
+    ready = true
+    return worker
+  } finally {
+    void mainnet.shutdown()
+  }
+}
+
+// boot never retries, so the error says how to.
+const booted = boot().catch((e: unknown) => {
+  stage = `Anon-RPC ${TRANSPORT} worker failed to start while ${stage}: ${errorText(
+    e
+  )}. Reload Kohaku on chrome://extensions to retry.`
+  throw new Error(stage)
+})
+booted.catch(() => {})
+
+async function handle(req: OffscreenRequest): Promise<OffscreenReply> {
+  if (req.kind === 'status') return { id: req.id, stage, ready }
+  const res = await (await booted).fetch(req.url, req.init)
+  return {
+    id: req.id,
+    status: res.status,
+    statusText: res.statusText,
+    headers: Object.fromEntries(res.headers),
+    body: await res.text()
+  }
+}
+
+chrome.runtime.onConnect.addListener((port) => {
+  if (port.name !== PORT_NAME) return
+  port.onMessage.addListener((req: OffscreenRequest) => {
+    handle(req).then(
+      (reply) => port.postMessage(reply),
+      (e: unknown) => port.postMessage({ id: req.id, error: errorText(e) } satisfies OffscreenReply)
+    )
+  })
+})
diff --git a/src/web/extension-services/tocsin-offscreen/protocol.ts b/src/web/extension-services/tocsin-offscreen/protocol.ts
new file mode 100644
index 000000000..19390ef88
--- /dev/null
+++ b/src/web/extension-services/tocsin-offscreen/protocol.ts
@@ -0,0 +1,24 @@
+// The port between the service worker (tocsinAnonRpc.ts) and the offscreen page (offscreen.ts).
+// A named port, not runtime.sendMessage: Kohaku's own pages answer broadcast messages first.
+export const PORT_NAME = 'tocsin-offscreen'
+
+export type OffscreenAsk =
+  | {
+      kind: 'fetch'
+      url: string
+      init: { method: string; headers: Record<string, string>; body?: string }
+    }
+  | { kind: 'status' }
+
+export type OffscreenRequest = OffscreenAsk & { id: number }
+
+export type OffscreenReply =
+  | {
+      id: number
+      status: number
+      statusText: string
+      headers: Record<string, string>
+      body: string
+    }
+  | { id: number; stage: string; ready: boolean }
+  | { id: number; error: string }
