+import { TocsinControllerStateContext } from '@web/contexts/tocsinControllerStateContext'
+
+export default function useTocsinControllerState() {
+  const context = useContext(TocsinControllerStateContext)
+
+  if (!context) {
+    throw new Error('useTocsinControllerState must be used within a TocsinControllerStateProvider')
+  }
+
+  return context
+}
