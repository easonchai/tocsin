+// The tocsin verdict panel for the send and signing screens: snap-ui.md sections 3 and 4 in
+// Kohaku's components. Every word comes from @ambire-common/libs/tocsin/display or check.
+import React from 'react'
+import { Pressable, View, ViewStyle } from 'react-native'
+
+import { BLOCKED_SEND_LINE, BLOCKED_SIGN_LINE } from '@ambire-common/libs/tocsin/check'
+import {
+  ago,
+  causeOf,
+  category,
+  CHECKING_LINE,
+  cleanLine,
+  flagBanner,
+  flaggedBy,
+  notes,
+  num,
+  PRIVACY_LINE,
+  proven,
+  RANK,
+  seenLine,
+  short,
+  sourceLine,
+  staleLine,
+  syncedLine,
+  type TocsinAssessment,
+  type TocsinView,
+  UNVERIFIABLE_LINE,
+  usable,
+  verdictTitle,
+  whyUnavailable,
+  writerLabel
+} from '@ambire-common/libs/tocsin/display'
+import type { Verdict } from '@ambire-common/libs/tocsin/reader'
+import InfoIcon from '@common/assets/svg/InfoIcon'
+import Alert from '@common/components/Alert'
+import Button from '@common/components/Button'
+import CopyText from '@common/components/CopyText'
+import BaseAddress from '@common/components/HumanizerAddress/components/BaseAddress'
+import Spinner from '@common/components/Spinner'
+import Text from '@common/components/Text'
+import Tooltip from '@common/components/Tooltip'
+import useTheme from '@common/hooks/useTheme'
+import spacings from '@common/styles/spacings'
+import common from '@common/styles/utils/common'
+import flexbox from '@common/styles/utils/flexbox'
+import { openInTab } from '@web/extension-services/background/webapi/tab'
+import useBackgroundService from '@web/hooks/useBackgroundService'
+import useTocsinControllerState from '@web/hooks/useTocsinControllerState'
+
+type Props = {
+  verdict: Verdict | 'checking'
+  /** The finished assessments behind `verdict`. */
+  assessments: readonly TocsinAssessment[]
+  chainId: bigint
+  /** What a block stops: a send (send screen, dApp transaction) or a signature. */
+  action: 'send' | 'sign'
+  style?: ViewStyle
+}
+
+const EXPLORER_TX = 'https://sepolia.etherscan.io/tx/'
+
+const Row = ({ label, children }: { label: string; children: React.ReactNode }) => (
+  <View style={[flexbox.directionRow, spacings.mbMi]}>
+    <Text fontSize={12} appearance="secondaryText" style={{ width: 80 }}>
+      {label}
+    </Text>
+    <View style={flexbox.flex1}>{children}</View>
+  </View>
+)
+
+const Value = ({ children, muted }: { children: React.ReactNode; muted?: boolean }) => (
+  <Text fontSize={12} appearance={muted ? 'secondaryText' : 'primaryText'} selectable>
+    {children}
+  </Text>
+)
+
+const Heading = ({
+  text,
+  line,
+  lineColor
+}: {
+  text: string
+  line?: string
+  lineColor?: 'errorText' | 'warningText'
+}) => (
+  <View style={spacings.mbSm}>
+    <Text fontSize={16} weight="semiBold" accessibilityRole="header">
+      {text}
+    </Text>
+    {!!line && (
+      <Text fontSize={14} appearance={lineColor}>
+        {line}
+      </Text>
+    )}
+  </View>
+)
+
+const Updating = ({ view }: { view: TocsinView }) =>
+  view.isSyncing ? (
+    <View style={[flexbox.directionRow, flexbox.alignCenter, spacings.mbMi]}>
+      <Spinner style={{ width: 16, height: 16, ...spacings.mrTy }} />
+      <Value muted>updating…</Value>
+    </View>
+  ) : null
+
+const Divider = () => {
+  const { theme } = useTheme()
+  return <View style={[{ height: 1, backgroundColor: theme.secondaryBorder }, spacings.mvSm]} />
+}
+
+const Privacy = () => (
+  <Text fontSize={10} appearance="secondaryText" style={spacings.mtTy}>
+    {PRIVACY_LINE}
+  </Text>
+)
+
+/** Sync state and the honesty line, under every panel (spec 3.2 step 5). */
+const SyncRows = ({ view }: { view: TocsinView }) => {
+  const stale = staleLine(view)
+  return (
+    <View>
+      <Divider />
+      <Row label="synced">
+        <Value muted>{syncedLine(view)}</Value>
+      </Row>
+      <Updating view={view} />
+      <Row label="proven">
+        <Value muted>{proven(view)}</Value>
+      </Row>
+      <Row label="source">
+        <Value muted>{sourceLine(view)}</Value>
+      </Row>
+      {!!stale && (
+        <Text fontSize={12} appearance="warningText">
+          {stale}
+        </Text>
+      )}
+      <Privacy />
+    </View>
+  )
+}
+
+/** Followed lists left out of this check, and a chain that is not the log's. */
+const Notes = ({ view, chainId }: { view: TocsinView; chainId: bigint }) => (
+  <>
+    {notes(view, chainId).map((n) => (
+      <Text key={n} fontSize={12} appearance="warningText" style={spacings.mbTy}>
+        {n}
+      </Text>
+    ))}
+  </>
+)
+
+const openEvidence = (hash: string) =>
+  // eslint-disable-next-line @typescript-eslint/no-floating-promises
+  openInTab({ url: `${EXPLORER_TX}${hash}`, shouldCloseCurrentWindow: false })
+
+/** One flagged address: why, who flagged it, and the evidence (spec 3.2 steps 2 and 3). */
+const Flag = ({ view, a }: { view: TocsinView; a: TocsinAssessment }) => {
+  const { theme } = useTheme()
+  const banner = flagBanner(a, view.policy)
+  const cats = [...new Set(a.findings.map((f) => f.category))].map(category)
+  const evidence = [...new Set(a.findings.map((f) => f.evidence))]
+  const tooltipId = `tocsin-category-${a.target.context}-${a.target.address}`
+  return (
+    <View style={spacings.mbSm}>
+      <Alert
+        type={a.verdict === 'block' ? 'error' : 'warning'}
+        size="sm"
+        title={banner.title}
+        text={banner.body}
+        style={spacings.mbSm}
+      />
+      <Row label="address">
+        <BaseAddress address={a.target.address} chainId={a.chainId} fontSize={12}>
+          {a.target.address}
+        </BaseAddress>
+      </Row>
+      <Row label="role">
+        <Value>{a.target.why}</Value>
+      </Row>
+      <Row label="category">
+        <View style={[flexbox.directionRow, flexbox.alignCenter]}>
+          <Value>{cats.map((c) => c.name).join(', ')}</Value>
+          <InfoIcon
+            data-tooltip-id={tooltipId}
+            data-tooltip-content={cats.map((c) => `${c.name}: ${c.desc}`).join(' ')}
+            aria-label={cats.map((c) => c.desc).join(' ')}
+            width={14}
+            height={14}
+            color={theme.secondaryText}
+            style={spacings.mlMi}
+          />
+          <Tooltip id={tooltipId} />
+        </View>
+      </Row>
+      {flaggedBy(view, a).map((line) => (
+        <Row key={line} label="flagged by">
+          <Value>{line}</Value>
+        </Row>
+      ))}
+      {evidence.map((h) => (
+        <Row key={h} label="evidence">
+          <View style={[flexbox.directionRow, flexbox.alignCenter]}>
+            <Pressable
+              accessibilityRole="link"
+              accessibilityLabel={`Open evidence ${short(h)} on Etherscan`}
+              onPress={() => openEvidence(h)}
+            >
+              <Text fontSize={12} appearance="primary" underline>
+                {short(h)}
+              </Text>
+            </Pressable>
+            <CopyText text={h} style={spacings.mlTy} iconWidth={12} iconHeight={12} />
+          </View>
+        </Row>
+      ))}
+      <Row label="seen">
+        <Value>{seenLine(view, a)}</Value>
+      </Row>
+      {a.unavailable.map((w) => (
+        <Row key={w} label={writerLabel(view, w)}>
+          <Text fontSize={12} appearance="warningText">
+            {whyUnavailable(view.sync?.writers[w])}
+          </Text>
+        </Row>
+      ))}
+    </View>
+  )
+}
+
+/** Spec 3.5. The lying-RPC beat lands here: neutral, never green, never red. */
+const Unverifiable = ({
+  view,
+  assessments,
+  chainId
+}: {
+  view: TocsinView
+  assessments: readonly TocsinAssessment[]
+  chainId: bigint
+}) => {
+  const { theme } = useTheme()
+  const { dispatch } = useBackgroundService()
+  const cause = causeOf(view, assessments)
+  const lg = view.lastGood
+  const diverged = Object.values(view.sync?.writers ?? {}).filter(
+    (w) => w.status === 'unavailable' && w.divergedAt !== undefined
+  )
+  return (
+    <>
+      <Heading
+        text={verdictTitle('unavailable')}
+        line={UNVERIFIABLE_LINE}
+        lineColor="warningText"
+      />
+      {/* Neutral, not Alert type="info": Kohaku's info colours are red, and red means block only. */}
+      <View
+        accessibilityRole="alert"
+        style={[
+          flexbox.directionRow,
+          spacings.phSm,
+          spacings.pvSm,
+          spacings.mbSm,
+          common.borderRadiusPrimary,
+          {
+            borderWidth: 1,
+            borderColor: theme.secondaryBorder,
+            backgroundColor: theme.secondaryBackground
+          }
+        ]}
+      >
+        <View style={spacings.mrTy}>
+          <InfoIcon width={20} height={20} color={theme.secondaryText} />
+        </View>
+        <View style={flexbox.flex1}>
+          <Text fontSize={14} weight="semiBold" style={spacings.mbMi}>
+            {cause.title}
+          </Text>
+          <Text fontSize={14} appearance="secondaryText">
+            {cause.body}
+          </Text>
+        </View>
+      </View>
+      <Notes view={view} chainId={chainId} />
+      <Divider />
+      <Row label="last good">
+        <Value muted>{lg ? `${num(lg.flags)} flags · ${ago(lg.at)}` : 'never'}</Value>
+      </Row>
+      <Row label="proven">
+        <Value muted>{proven(view)}</Value>
+      </Row>
+      {diverged.map((w) => (
+        <Row key={w.writer} label="replayed">
+          <Text fontSize={12} appearance="warningText">
+            {`${writerLabel(view, w.writer)} · ${whyUnavailable(w)}`}
+          </Text>
+        </Row>
+      ))}
+      <Row label="source">
+        <Value muted>{sourceLine(view)}</Value>
+      </Row>
+      <Updating view={view} />
+      <Button
+        text="Retry sync"
+        type="secondary"
+        size="small"
+        disabled={view.isSyncing}
+        onPress={() => dispatch({ type: 'TOCSIN_CONTROLLER_SYNC' })}
+        hasBottomSpacing={false}
+        style={[flexbox.alignSelfStart, spacings.mtTy]}
+      />
+      <Privacy />
+    </>
+  )
+}
+
+const Body = ({
+  view,
+  verdict,
+  assessments,
+  chainId,
+  action
+}: Omit<Props, 'style'> & { view: TocsinView }) => {
+  if (verdict === 'checking') {
+    return (
+      <>
+        <View style={[flexbox.directionRow, flexbox.alignCenter, spacings.mbSm]}>
+          <Spinner style={{ width: 20, height: 20, ...spacings.mrTy }} />
+          <Heading text={verdictTitle('checking')} />
+        </View>
+        <Value>{CHECKING_LINE}</Value>
+        <SyncRows view={view} />
+      </>
+    )
+  }
+  if (verdict === 'unavailable') {
+    return <Unverifiable view={view} assessments={assessments} chainId={chainId} />
+  }
+  if (assessments.length === 0) {
+    return (
+      <>
+        <Value>No address in this request to check.</Value>
+        <SyncRows view={view} />
+      </>
+    )
+  }
+  if (verdict === 'clean') {
+    const lists = view.lists.filter(usable).map((l) => l.name)
+    return (
+      <>
+        <Heading text={verdictTitle('clean')} />
+        <Alert
+          type="success"
+          size="sm"
+          title="Not on any list you follow"
+          text={cleanLine(view)}
+          style={spacings.mbSm}
+        />
+        <Notes view={view} chainId={chainId} />
+        {assessments.map((a) => (
+          <Row key={`${a.target.context}:${a.target.address}`} label="checked">
+            <Value>{`${a.target.why} ${short(a.target.address)}`}</Value>
+          </Row>
+        ))}
+        <Row label="lists">
+          <Value>{lists.join(', ')}</Value>
+        </Row>
+        <SyncRows view={view} />
+      </>
+    )
+  }
+  const block = verdict === 'block'
+  const flagged = assessments
+    .filter((a) => a.findings.length > 0)
+    .sort((x, y) => RANK[y.verdict] - RANK[x.verdict])
+  return (
+    <>
+      <Heading
+        text={verdictTitle(verdict)}
+        line={
+          block
+            ? action === 'send'
+              ? BLOCKED_SEND_LINE
+              : BLOCKED_SIGN_LINE
+            : 'Check this address before you continue.'
+        }
+        lineColor={block ? 'errorText' : 'warningText'}
+      />
+      <Notes view={view} chainId={chainId} />
+      {flagged.map((a) => (
+        <Flag key={`${a.target.context}:${a.target.address}`} view={view} a={a} />
+      ))}
+      <SyncRows view={view} />
+    </>
+  )
+}
+
+const VerdictPanel = ({ style, ...body }: Props) => {
+  const view = useTocsinControllerState()
+  const { theme } = useTheme()
+  // The context holds {} until the background sends the first state.
+  if (!view?.settings) return null
+  const flagged = body.verdict === 'block' || body.verdict === 'warn'
+  return (
+    <View
+      // Announced on arrival, so a screen reader hears a block before reaching Sign.
+      accessibilityRole={flagged ? 'alert' : undefined}
+      style={[
+        common.borderRadiusPrimary,
+        spacings.phSm,
+        spacings.pvSm,
+        {
+          borderWidth: 1,
+          borderColor: theme.secondaryBorder,
+          backgroundColor: theme.primaryBackground
+        },
+        style
+      ]}
+    >
+      <Body {...body} view={view} />
+    </View>
+  )
+}
+
+export default React.memo(VerdictPanel)
