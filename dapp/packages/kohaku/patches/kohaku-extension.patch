diff --git a/src/web/extension-services/background/tocsinAnonRpc.ts b/src/web/extension-services/background/tocsinAnonRpc.ts
new file mode 100644
index 000000000..c35265a44
--- /dev/null
+++ b/src/web/extension-services/background/tocsinAnonRpc.ts
@@ -0,0 +1,115 @@
+// Tocsin's fetch for the service worker: every read leaves through the Anon-RPC worker in the
+// offscreen page, except localhost (the user's own lying proxy or list server, nothing to hide
+// from) and the `direct` transport. Only the request itself crosses; nothing is stored or logged.
+import {
+  type OffscreenAsk,
+  type OffscreenReply,
+  type OffscreenRequest,
+  PORT_NAME
+} from '../tocsin-offscreen/protocol'
+
+const TRANSPORT = process.env.TOCSIN_TRANSPORT || 'tor'
+const OFFSCREEN_URL = 'tocsin-offscreen.html'
+const BOOT_WAIT_MS = 120_000
+
+// @types/chrome here predates the offscreen API.
+type OffscreenApi = {
+  hasDocument(): Promise<boolean>
+  createDocument(o: { url: string; reasons: string[]; justification: string }): Promise<void>
+}
+const offscreen = () => (chrome as unknown as { offscreen: OffscreenApi }).offscreen
+
+let creating: Promise<void> | undefined
+/** Opens the offscreen page once; the worker boots on open, so call it at start-up, not on the first send. */
+export async function ensureTocsinOffscreen(): Promise<void> {
+  if (TRANSPORT === 'direct' || (await offscreen().hasDocument())) return
+  creating ??= offscreen()
+    .createDocument({
+      url: OFFSCREEN_URL,
+      reasons: ['WORKERS', 'IFRAME_SCRIPTING', 'WEB_RTC'],
+      justification:
+        'Runs the Anon-RPC worker that fetches Tocsin threat flags without revealing this device.'
+    })
+    .finally(() => {
+      creating = undefined
+    })
+  await creating
+}
+
+let port: chrome.runtime.Port | undefined
+let nextId = 1
+const pending = new Map<number, { resolve: (r: OffscreenReply) => void; reject: (e: Error) => void }>()
+
+function connect(): chrome.runtime.Port {
+  if (port) return port
+  const p = chrome.runtime.connect({ name: PORT_NAME })
+  p.onMessage.addListener((reply: OffscreenReply) => {
+    pending.get(reply.id)?.resolve(reply)
+    pending.delete(reply.id)
+  })
+  p.onDisconnect.addListener(() => {
+    if (port === p) port = undefined
+    for (const [id, { reject }] of pending) {
+      reject(new Error('the Tocsin Anon-RPC page went away'))
+      pending.delete(id)
+    }
+  })
+  port = p
+  return p
+}
+
+async function ask(req: OffscreenAsk, signal?: AbortSignal): Promise<OffscreenReply> {
+  await ensureTocsinOffscreen()
+  const id = nextId++
+  return new Promise<OffscreenReply>((resolve, reject) => {
+    pending.set(id, { resolve, reject })
+    // The controller's timeout aborts the signal; the relay cannot cancel the worker, so it stops waiting instead.
+    signal?.addEventListener(
+      'abort',
+      () => {
+        pending.delete(id)
+        reject(signal.reason instanceof Error ? signal.reason : new Error('aborted'))
+      },
+      { once: true }
+    )
+    connect().postMessage({ ...req, id } satisfies OffscreenRequest)
+  })
+}
+
+/** Resolves once the worker is ready, or with the boot error; gives up after BOOT_WAIT_MS. */
+export async function waitForTocsinWorker(): Promise<void> {
+  if (TRANSPORT === 'direct') return
+  const until = Date.now() + BOOT_WAIT_MS
+  while (Date.now() < until) {
+    const r = await ask({ kind: 'status' })
+    if ('error' in r) throw new Error(r.error)
+    if ('ready' in r) {
+      if (r.ready) return
+      if (r.stage.startsWith('Anon-RPC')) throw new Error(r.stage)
+    }
+    await new Promise((res) => setTimeout(res, 2000))
+  }
+  throw new Error('the Anon-RPC worker took over two minutes to start')
+}
+
+const isLocal = (url: string) => /^(localhost|127\.0\.0\.1|\[::1\])$/.test(new URL(url).hostname)
+
+export const tocsinFetch: typeof globalThis.fetch = async (input, init) => {
+  const req = new Request(input, init)
+  if (TRANSPORT === 'direct' || isLocal(req.url)) return fetch(req)
+  const r = await ask(
+    {
+      kind: 'fetch',
+      url: req.url,
+      init: {
+        method: req.method,
+        headers: Object.fromEntries(req.headers),
+        body: (await req.text()) || undefined
+      }
+    },
+    req.signal
+  )
+  if ('error' in r) throw new Error(r.error)
+  if (!('status' in r)) throw new Error('the Tocsin Anon-RPC page sent the wrong reply')
+  return new Response(r.body, { status: r.status, statusText: r.statusText, headers: r.headers })
+}
