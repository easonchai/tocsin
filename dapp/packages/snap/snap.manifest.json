{
  "version": "0.0.1",
  "description": "Checks recipients, spenders and permits against threat flags in an on-chain log, from writers on a signed list you pin. Best-effort: the header comes from an RPC.",
  "proposedName": "Tocsin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/easonchai/tocsin.git",
    "directory": "dapp/packages/snap"
  },
  "source": {
    "shasum": "XOg/xl8u+NlAJSTmpQR7Eh0tyDv/OOaZzYizi5/ACiI=",
    "location": {
      "npm": {
        "filePath": "dist/bundle.js",
        "iconPath": "images/icon.svg",
        "packageName": "@mengo6988/tocsin-snap",
        "registry": "https://registry.npmjs.org/"
      }
    }
  },
  "initialPermissions": {
    "endowment:transaction-insight": {
      "allowTransactionOrigin": false
    },
    "endowment:signature-insight": {
      "allowSignatureOrigin": false
    },
    "endowment:cronjob": {
      "jobs": [
        {
          "expression": "*/5 * * * *",
          "request": {
            "method": "sync"
          }
        }
      ]
    },
    "endowment:network-access": {},
    "endowment:lifecycle-hooks": {},
    "endowment:page-settings": {},
    "endowment:page-home": {},
    "snap_manageState": {},
    "snap_dialog": {}
  },
  "platformVersion": "12.1.0",
  "manifestVersion": "0.1"
}
