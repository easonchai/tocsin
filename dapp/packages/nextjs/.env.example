# Template for NextJS environment variables.

# For local development, copy this file, rename it to .env.local, and fill in the values.
# When deploying live, you'll need to store the vars in Vercel/System config.

# If not set, we provide default values (check `scaffold.config.ts`) so developers can start prototyping out of the box,
# but we recommend getting your own API Keys for Production Apps.

# To access the values stored in this env file you can use: process.env.VARIABLENAME
# You'll need to prefix the variables names with NEXT_PUBLIC_ if you want to access them on the client side.
# More info: https://nextjs.org/docs/pages/building-your-application/configuring/environment-variables
NEXT_PUBLIC_ALCHEMY_API_KEY=
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# /harness page (demo ticket 01). Every value is bundled into the client, so never put a keyed URL here
# in a committed file; a keyed endpoint goes in the ignored .env.local. The values below are public and keyless.
# Consensus endpoints must serve the light-client API (/eth/v1/beacon/light_client/*) with CORS and a
# finality_update less than about a minute old. On 2026-11-06 Lodestar was the only public Sepolia server with
# that API; publicnode's mainnet beacon API had fresher finality updates than lodestar-mainnet.
NEXT_PUBLIC_HARNESS_SEPOLIA_CONSENSUS_RPC=https://lodestar-sepolia.chainsafe.io
# Both execution RPCs must serve eth_getProof for finalized blocks (about 70 behind head). Reth-backed public
# endpoints (publicnode on Sepolia and on some mainnet backends, sentio, tenderly, flashbots) refuse anything
# older than a few blocks; 0xrpc.io runs Geth. The right Sepolia RPC depends on the transport (2026-11-06):
# Tor: 0xrpc.io/sep. Tenderly answers Tor exits with 403.
# Nym: https://sepolia.gateway.tenderly.co. The Nym worker drops request headers and 0xrpc.io answers 415.
NEXT_PUBLIC_HARNESS_SEPOLIA_EXECUTION_RPC=https://0xrpc.io/sep
# The Anon-RPC specifiers live on mainnet, so the worker bootstrap syncs a mainnet light client.
NEXT_PUBLIC_HARNESS_MAINNET_CONSENSUS_RPC=https://ethereum-beacon-api.publicnode.com
NEXT_PUBLIC_HARNESS_MAINNET_EXECUTION_RPC=https://0xrpc.io/eth
# tor-js has no default gateway. This is the Anon-RPC demo gateway (limited capacity, may go away; down on 2026-11-06).
# For the stage run tor-js-gateway (ethereum/tor-js, crates/tor-js-gateway) on this machine and use
# 127.0.0.1:12298:<certhash it prints>.
NEXT_PUBLIC_HARNESS_TOR_GATEWAYS=152.236.3.22:12298:uEiCH0VdbhryzJcMtCfB0vLA4sOvHdQ4hq5w7CopcwU59bQ
# Comma-separated writer addresses whose writerHead and writerSeq the page proves. Empty proves the mapping roots at slots 2 and 3.
NEXT_PUBLIC_HARNESS_WRITERS=

