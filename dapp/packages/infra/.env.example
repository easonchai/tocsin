# Copy to .env (ignored by git) and fill in. Never commit values. A key that appears in a chat,
# a ticket, or a commit is burned: replace it.

# JSON-RPC endpoint. A URL that embeds an API key is a secret too.
RPC_URL=
# The chain id the scripts expect. They refuse to broadcast if RPC_URL answers a different one. Sepolia is 11155111.
CHAIN_ID=
# The deployed ThreatFlagLog address (log-contract ticket 06).
LOG_ADDRESS=

# The team's manual writer. Pays its own gas for `append`. Needs Sepolia ETH.
MANUAL_WRITER_PRIVATE_KEY=
# The detector writer. Signs `Append` batches only and never holds ETH.
DETECTOR_PRIVATE_KEY=
# Pays gas for `appendSigned`. Needs Sepolia ETH. Must differ from both writer keys.
RELAYER_PRIVATE_KEY=

# Detector tuning (yarn detect). All optional; the defaults are shown.
# Hex characters at the start and end of an address that must match for a lookalike.
# DETECTOR_PREFIX_HEX=4
# DETECTOR_SUFFIX_HEX=4
# A native transfer above 0 and below this many wei is dust.
# DETECTOR_DUST_WEI=100000000000000
# A token transfer below this many raw units (any decimals) is dust.
# DETECTOR_DUST_TOKEN_UNITS=10000
# Fixed cap on leaves the detector accepts per trailing hour.
# DETECTOR_LEAVES_PER_HOUR=50
# Seconds between batches.
# DETECTOR_FLUSH_SECONDS=300
# First block to scan; defaults to the current head.
# DETECTOR_FROM_BLOCK=

# Demo beats (yarn eval, yarn mirror, yarn lying-proxy).
# The list's ENS record value, the hex that `publish-list sign` prints. Not secret.
LIST_RECORD=
# The list document; defaults to site/lists/default.json.
# LIST_DOCUMENT=
# The log's deployment block, where eth_getLogs scans start. 0 works on anvil; set it on Sepolia.
LOG_FROM_BLOCK=
# Blocks per eth_getLogs call. Lower it if the RPC caps the span.
# LOG_BLOCK_RANGE=10000
# Where `eval --source proxy` sends eth_getLogs, and where the lying proxy listens.
# PROXY_URL=http://127.0.0.1:8550
# PROXY_PORT=8550
# The proxy drops this writer's Appended log at this sequence. Writer defaults to the manual writer in the seed manifest.
# PROXY_DROP_WRITER=
# PROXY_DROP_SEQ=1

# ENS (yarn ens-setup, yarn ens-publish). Sepolia only; contract addresses come from ensjs.
# The team's .eth name, registered at sepolia.app.ens.domains by the owner key below.
ENS_NAME=
# Holds the name and administers its resolver and subregistry. Needs Sepolia ETH for ens-setup.
ENS_OWNER_PRIVATE_KEY=
# One subname per writer, label=address, comma separated, e.g. manual=0x...,detector=0x...
ENS_WRITERS=
# The list maintainer's address. ens-setup grants it setText on the two list keys and nothing else.
ENS_MAINTAINER=
# The list maintainer's key, used by ens-publish only. Needs Sepolia ETH. Must match ENS_MAINTAINER.
MAINTAINER_PRIVATE_KEY=
