# Copy to .env (ignored by git) and fill in. Never commit values. A key that appears in a chat,
# a ticket, or a commit is burned: replace it.

# JSON-RPC endpoint. A URL that embeds an API key is a secret too.
RPC_URL=
# The chain id the scripts expect. They refuse to broadcast if RPC_URL answers a different one. Sepolia is 11155111.
CHAIN_ID=
# The deployed ThreatFlagLog address (log-contract ticket 06).
LOG_ADDRESS=

# The team's manual writer. Pays its own gas for `append`. Needs Sepolia ETH.
MANUAL_WRITER_PRIVATE_KEY=
# The detector writer. Signs `Append` batches only and never holds ETH.
DETECTOR_PRIVATE_KEY=
# Pays gas for `appendSigned`. Needs Sepolia ETH. Must differ from both writer keys.
RELAYER_PRIVATE_KEY=
